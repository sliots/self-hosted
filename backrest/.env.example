# 来源：https://github.com/garethgeorge/backrest
# Compose 配置
# IMAGE_TAG=v1.14.1
# CONTAINER_NAME=backrest
# BIND_ADDRESS=0.0.0.0
# PORT=9898
# WATCHTOWER_ENABLE=true

# 宿主机路径
# Backrest 的数据、配置、缓存、临时文件和 rclone 配置默认保存在此目录下。
# MNT_DIR=/mnt/docker
# 要备份的宿主机目录；Compose 以只读方式挂载到容器内 /userdata。
# USERDATA_DIR=/mnt/docker
# 使用本地 restic 仓库时，先取消 Compose 中 /repos 挂载的注释。
# REPOS_DIR=/mnt/docker/backrest/repos

# Backrest 配置
# hostname 会写入 restic 快照；部署后修改会使新旧快照显示不同的主机名。
# BACKREST_HOSTNAME=backrest
# Docker 镜像默认监听 0.0.0.0:9898。修改端口时还需同步调整 Compose 的容器端口。
# BACKREST_PORT=0.0.0.0:9898

# 以下路径已由 Compose 固定，并与容器卷挂载保持一致。
# 如需修改，必须同时调整 docker-compose.yml 中的 environment 和 volumes。
# BACKREST_CONFIG=/config/config.json
# BACKREST_DATA=/data
# XDG_CACHE_HOME=/cache
# TMPDIR=/tmp

# 默认留空时使用 Backrest 管理的 restic。自定义时需将该二进制挂载到容器内。
# BACKREST_RESTIC_COMMAND=

# 时区
# TZ=Asia/Shanghai
