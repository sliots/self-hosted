# 来源：https://github.com/raylabshq/gitea-mirror
# Compose 配置
# BIND_ADDRESS=0.0.0.0
# CONTAINER_NAME=gitea-mirror
# DOCKER_REGISTRY=ghcr.io
# DOCKER_IMAGE=raylabshq/gitea-mirror
# DOCKER_TAG=v3.27.2
# HOST_PORT=4321
# MNT_DIR=/mnt/docker
# WATCHTOWER_ENABLE=true

# 必填：用于签署会话，可通过 openssl rand -base64 32 生成。
BETTER_AUTH_SECRET=

# 应用基础配置
# NODE_ENV 常用值：production、development、test。
# NODE_ENV=production
# HOST=0.0.0.0
# PORT=4321
# 根路径使用 /；子路径部署可使用 /mirror 等前缀。
# BASE_URL=/
# DATABASE_URL=sqlite://data/gitea-mirror.db

# 认证与加密
# BETTER_AUTH_URL 只填 scheme + host，不包含 BASE_URL 子路径。
# BETTER_AUTH_URL=https://mirror.example.com
# PUBLIC_BETTER_AUTH_URL=https://mirror.example.com
# BETTER_AUTH_TRUSTED_ORIGINS=https://mirror.example.com,http://192.0.2.10:4321
# BETTER_AUTH_LOG_LEVEL 可选值：debug、info、warn、error。
# BETTER_AUTH_LOG_LEVEL=warn
# 可选：用于加密 token，可通过 openssl rand -base64 48 生成。
# ENCRYPTION_SECRET=

# 应用直接提供 HTTPS；必须同时设置证书和私钥路径。
# SERVER_CERT_PATH=/app/certs/tls.crt
# SERVER_KEY_PATH=/app/certs/tls.key

# GitHub 账户
# GITHUB_USERNAME=
# GITHUB_TOKEN=
# GITHUB_TYPE 可选值：personal、organization。
# GITHUB_TYPE=personal
# GitHub Enterprise Server 通常使用 https://ghe.example.com/api/v3。
# GH_API_URL=https://api.github.com

# GitHub 仓库筛选
# PRIVATE_REPOSITORIES=false
# PUBLIC_REPOSITORIES=true
# INCLUDE_ARCHIVED=false
# INCLUDE_COLLABORATOR_REPOS=true
# SKIP_FORKS=false
# MIRROR_STARRED=false
# MIRROR_STARRED_LISTS=
# STARRED_REPOS_ORG=starred
# STARRED_REPOS_MODE 可选值：dedicated-org、preserve-owner。
# STARRED_REPOS_MODE=dedicated-org
# STARRED_DUPLICATE_STRATEGY 可选值：suffix、prefix、owner-org。
# STARRED_DUPLICATE_STRATEGY=suffix

# GitHub 组织筛选
# MIRROR_ORGANIZATIONS=false
# PRESERVE_ORG_STRUCTURE=false
# ONLY_MIRROR_ORGS=false
# INCLUDE_ORGANIZATIONS=
# MIRROR_STRATEGY 可选值：preserve、single-org、flat-user、mixed。
# MIRROR_STRATEGY=preserve
# SKIP_STARRED_ISSUES=false
# AUTO_MIRROR_STARRED=false

# Gitea / Forgejo 连接
# GITEA_URL=https://git.example.com
# 可选：仅用于浏览器仪表盘链接，API 仍使用 GITEA_URL。
# GITEA_EXTERNAL_URL=https://git.example.com
# GITEA_TOKEN=
# GITEA_USERNAME=
# GITEA_ORGANIZATION=github-mirrors

# Gitea 同步行为
# GITEA_ORG_VISIBILITY 可选值：public、private、limited、default。
# GITEA_ORG_VISIBILITY=public
# 支持 30m、1h、8h、24h、1d 等 duration，也可使用秒数。
# GITEA_MIRROR_INTERVAL=8h
# GITEA_LFS=false
# GITEA_CREATE_ORG=true
# GITEA_PRESERVE_VISIBILITY=false

# 模板仓库
# GITEA_TEMPLATE_OWNER=
# GITEA_TEMPLATE_REPO=

# Topics
# GITEA_ADD_TOPICS=true
# GITEA_TOPIC_PREFIX=

# Fork 处理
# GITEA_FORK_STRATEGY 可选值：skip、reference、full-copy。
# GITEA_FORK_STRATEGY=reference

# TLS 校验
# 仅用于测试或无法安装内部 CA 的临时场景。
# GITEA_SKIP_TLS_VERIFY=false

# Release、Wiki 与元数据镜像
# MIRROR_RELEASES=false
# RELEASE_LIMIT=10
# MIRROR_WIKI=false
# MIRROR_METADATA=false
# MIRROR_ISSUES=false
# MIRROR_PULL_REQUESTS=false
# MIRROR_LABELS=false
# MIRROR_MILESTONES=false
# MIRROR_ISSUE_CONCURRENCY=3
# MIRROR_PULL_REQUEST_CONCURRENCY=5

# 调度基础配置
# 启用 SCHEDULE_ENABLED 后会在启动时自动导入并镜像所有仓库。
# SCHEDULE_ENABLED=false
# SCHEDULE_INTERVAL 支持秒数或 cron，例如 0 2 * * *。
# SCHEDULE_INTERVAL=3600
# DELAY=3600

# 调度并发与重试
# SCHEDULE_CONCURRENT=false
# SCHEDULE_BATCH_SIZE=10
# SCHEDULE_PAUSE_BETWEEN_BATCHES=5000
# SCHEDULE_RETRY_ATTEMPTS=3
# SCHEDULE_RETRY_DELAY=60000
# SCHEDULE_TIMEOUT=3600000
# SCHEDULE_AUTO_RETRY=true

# 自动导入与镜像
# AUTO_IMPORT_REPOS=true
# AUTO_MIRROR_REPOS=false
# SCHEDULE_ONLY_MIRROR_UPDATED=false
# SCHEDULE_UPDATE_INTERVAL=86400000
# SCHEDULE_SKIP_RECENTLY_MIRRORED=true
# SCHEDULE_RECENT_THRESHOLD=3600000

# 调度清理、通知与日志
# SCHEDULE_CLEANUP_BEFORE_MIRROR=false
# SCHEDULE_NOTIFY_ON_FAILURE=true
# SCHEDULE_NOTIFY_ON_SUCCESS=false
# SCHEDULE_LOG_LEVEL 可选值：error、warn、info、debug。
# SCHEDULE_LOG_LEVEL=info
# SCHEDULE_TIMEZONE=UTC

# 运行记录清理
# CLEANUP_ENABLED=false
# CLEANUP_RETENTION_DAYS=7

# 孤立仓库清理
# 建议先保持 CLEANUP_DELETE_FROM_GITEA=false 和 CLEANUP_DRY_RUN=true 验证结果。
# CLEANUP_DELETE_FROM_GITEA=false
# CLEANUP_DELETE_IF_NOT_IN_GITHUB=false
# CLEANUP_ORPHANED_REPO_ACTION 可选值：skip、archive、delete；优先使用 archive。
# CLEANUP_ORPHANED_REPO_ACTION=archive
# CLEANUP_DRY_RUN=true
# CLEANUP_PROTECTED_REPOS=
# CLEANUP_BATCH_SIZE=10
# CLEANUP_PAUSE_BETWEEN_DELETES=2000

# 反向代理 Header 认证
# HEADER_AUTH_ENABLED=false
# HEADER_AUTH_USER_HEADER=X-Authentik-Username
# HEADER_AUTH_EMAIL_HEADER=X-Authentik-Email
# HEADER_AUTH_NAME_HEADER=X-Authentik-Name
# HEADER_AUTH_AUTO_PROVISION=false
# HEADER_AUTH_ALLOWED_DOMAINS=
