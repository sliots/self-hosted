# 来源：https://beszel.dev/zh/guide/what-is-beszel
# Compose 配置
# IMAGE_TAG=0
# CONTAINER_NAME=beszel-agent
# WATCHTOWER_ENABLE=true

# Agent 连接配置
# 所有 Agent 变量也可以使用 BESZEL_AGENT_ 前缀。
# 从 Beszel Hub 添加系统时获取以下值。
KEY=
TOKEN=
HUB_URL=http://localhost:8090

# 监听与网络
# LISTEN=45876
# NETWORK=tcp
# ALL_PROXY=
# DISABLE_SSH=false
# EXIT_ON_DNS_ERROR=false
# SYSTEM_NAME=

# Docker 监控
# DOCKER_HOST=unix:///var/run/docker.sock
# DOCKER_TIMEOUT=2100ms
# EXCLUDE_CONTAINERS=

# 数据与磁盘
# DATA_DIR=/var/lib/beszel-agent
# FILESYSTEM=
# EXTRA_FILESYSTEMS=
# DISK_USAGE_CACHE=
# EXCLUDE_SMART=
# SMART_DEVICES=
# SMART_DEVICES_SEPARATOR=,
# SMART_INTERVAL=1h

# 网络接口、传感器与内存
# NICS=
# PRIMARY_SENSOR=
# SENSORS=
# SENSORS_TIMEOUT=2s
# SYS_SENSORS=
# MEM_CALC=

# GPU
# GPU_COLLECTOR=
# INTEL_GPU_DEVICE=
# LHM=false
# NVML=false
# SKIP_GPU=false

# systemd
# SERVICE_PATTERNS=
# SKIP_SYSTEMD=false

# 其他
# LOG_LEVEL=info

# 从文件读取凭据，可替代 KEY / TOKEN。
# KEY_FILE=
# TOKEN_FILE=

# 已弃用：使用 LISTEN。
# PORT=45876
# 已弃用：使用 GPU_COLLECTOR=amd_sysfs。
# AMD_SYSFS=false
