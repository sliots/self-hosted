# 来源：https://www.meilisearch.com/docs/resources/self_hosting/getting_started/docker
# Compose 必填配置
# 生产环境至少 16 字节；建议使用密码生成器创建更长随机值。
MEILI_MASTER_KEY=

# Compose 可选配置
# BIND_ADDRESS=0.0.0.0
# CONTAINER_NAME=meilisearch
# 设为宿主绝对路径时使用 bind mount；默认使用命名卷。
# DATA_DIR=meili_data
# IMAGE_TAG=v1.53.1
# PORT=7700
# RESOURCES_LIMITS_MEMORY=500m
# WATCHTOWER_ENABLE=false

# 基础运行配置
# 当前 Compose 会默认并覆盖为 production。
# MEILI_ENV 可选值：development、production。
# MEILI_ENV=production
# 当前 Compose 端口映射按 0.0.0.0:7700 配置；修改时需同步调整映射目标。
# MEILI_HTTP_ADDR=0.0.0.0:7700
# 建议将数据库保持在已挂载的 /meili_data 中。
# MEILI_DB_PATH=/meili_data/data.ms
# MEILI_CONFIG_FILE_PATH=/meili_data/config.toml
# 设置后禁用匿名 telemetry。
# MEILI_NO_ANALYTICS=true
# 字节数；默认为 104857600（100 MiB）。
# MEILI_HTTP_PAYLOAD_SIZE_LIMIT=104857600
# MEILI_LOG_LEVEL 可选值：OFF、ERROR、WARN、INFO、DEBUG、TRACE。
# MEILI_LOG_LEVEL=INFO
# 可使用字节数或人类可读单位，例如 2 GiB。
# MEILI_MAX_INDEXING_MEMORY=2 GiB
# MEILI_MAX_INDEXING_THREADS=2

# Dump
# MEILI_DUMP_DIR=/meili_data/dumps
# 启动时导入的 dump 文件路径。
# MEILI_IMPORT_DUMP=
# MEILI_IGNORE_MISSING_DUMP=true
# MEILI_IGNORE_DUMP_IF_DB_EXISTS=true

# Snapshot
# MEILI_SNAPSHOT_DIR=/meili_data/snapshots
# 可设为 false、true 或快照间隔秒数。
# MEILI_SCHEDULE_SNAPSHOT=false
# 启动时导入的 snapshot 文件路径。
# MEILI_IMPORT_SNAPSHOT=
# MEILI_IGNORE_MISSING_SNAPSHOT=true
# MEILI_IGNORE_SNAPSHOT_IF_DB_EXISTS=true

# 数据库升级
# 只在按官方升级流程处理数据库时启用。
# MEILI_UPGRADE_DB=true

# Task webhook
# MEILI_TASK_WEBHOOK_URL=
# 完整 Authorization header，例如 Bearer <token>；不要提交真实值。
# MEILI_TASK_WEBHOOK_AUTHORIZATION_HEADER=

# TLS
# 证书文件可存放在 /meili_data/certs 以使用当前数据卷。
# MEILI_SSL_CERT_PATH=/meili_data/certs/tls.crt
# MEILI_SSL_KEY_PATH=/meili_data/certs/tls.key
# MEILI_SSL_AUTH_PATH=
# MEILI_SSL_OCSP_PATH=
# 下列三项均为“设置即启用”的开关。
# MEILI_SSL_REQUIRE_AUTH=true
# MEILI_SSL_RESUMPTION=true
# MEILI_SSL_TICKETS=true

# S3 snapshot
# MEILI_S3_BUCKET_URL=
# MEILI_S3_BUCKET_REGION=
# MEILI_S3_BUCKET_NAME=
# MEILI_S3_ACCESS_KEY=
# MEILI_S3_SECRET_KEY=
# MEILI_S3_SNAPSHOT_PREFIX=

# 实验性：监控、日志与网络
# 实验性选项可在版本升级时变更或移除。
# MEILI_EXPERIMENTAL_ENABLE_METRICS=true
# 启用 metrics 或 logs route 后，建议限制允许访问的 IP/CIDR。
# MEILI_EXPERIMENTAL_ALLOWED_IP_NETWORKS=
# MEILI_EXPERIMENTAL_ENABLE_LOGS_ROUTE=true
# MEILI_EXPERIMENTAL_LOGS_MODE 可选值：human、json、profile。
# MEILI_EXPERIMENTAL_LOGS_MODE=human

# 实验性：搜索与队列
# MEILI_EXPERIMENTAL_CONTAINS_FILTER=false
# 搜索队列最大请求数。
# MEILI_EXPERIMENTAL_SEARCH_QUEUE_SIZE=1000
# MEILI_EXPERIMENTAL_NB_SEARCHES_PER_CORE=4
# 超时后取消客户端已断开的搜索，单位秒。
# MEILI_EXPERIMENTAL_DROP_SEARCH_AFTER=60
# MEILI_EXPERIMENTAL_REMOTE_SEARCH_TIMEOUT_SECONDS=30
# MEILI_EXPERIMENTAL_EMBEDDING_CACHE_ENTRIES=0
# v1.53.1 新增：限制任务队列并发 reader 数。
# MEILI_EXPERIMENTAL_TASK_QUEUE_MAX_READERS=100

# 实验性：索引与任务批处理
# 默认不限制；需要限制时填写正整数。
# MEILI_EXPERIMENTAL_MAX_NUMBER_OF_BATCHED_TASKS=
# 字节数；默认为可用内存的一半，最大 10 GiB。
# MEILI_EXPERIMENTAL_LIMIT_BATCHED_TASKS_TOTAL_SIZE=
# MEILI_EXPERIMENTAL_REDUCE_INDEXING_MEMORY_USAGE=true
# MEILI_EXPERIMENTAL_DISABLE_FID_BASED_DATABASES_CLEANUP=true
# MEILI_EXPERIMENTAL_NO_EDITION_2024_FOR_SETTINGS=true

# 实验性：Dynamic Search Rules fuel
# MEILI_EXPERIMENTAL_DSR_FUEL_MAX_ACTIVE_RULES=1000
# MEILI_EXPERIMENTAL_DSR_FUEL_MAX_COUNTED_WORDS=10
# MEILI_EXPERIMENTAL_DSR_FUEL_MAX_PIN_ACTIONS=100
# MEILI_EXPERIMENTAL_DSR_FUEL_WORD_FUEL=4096
# MEILI_EXPERIMENTAL_PERSONALIZATION_API_KEY=

# 实验性：S3 高级选项
# 必须大于 10 MiB；留空时内部使用 375 MiB。
# MEILI_EXPERIMENTAL_S3_MULTIPART_PART_SIZE=
# MEILI_EXPERIMENTAL_S3_MAX_IN_FLIGHT_PARTS=10
# MEILI_EXPERIMENTAL_S3_COMPRESSION_LEVEL=0
# MEILI_EXPERIMENTAL_S3_ROLE_ARN=
# MEILI_EXPERIMENTAL_S3_WEB_IDENTITY_TOKEN_FILE=
# MEILI_EXPERIMENTAL_S3_SIGNATURE_DURATION_SECONDS=28800
