# 来源：https://hub.docker.com/r/diygod/rsshub；https://github.com/DIYgod/RSSHub/blob/master/docker-compose.yml
# Docker Compose 环境变量示例

# Compose 可选配置
# 当前使用内置 Chromium 的 chromium-bundled 镜像；改用 latest 等标准镜像时，
# 需要另行提供 PLAYWRIGHT_WS_ENDPOINT、PLAYWRIGHT_CDP_ENDPOINT 或 Chromium 可执行文件。
# RSSHUB_IMAGE_TAG=chromium-bundled
# RSSHUB_CONTAINER_NAME=rsshub
# BIND_ADDRESS=0.0.0.0
# RSSHUB_HOST_PORT=1200
# RSSHUB_WATCHTOWER_ENABLE=true
# REDIS_IMAGE_TAG=7.4.8-alpine
# REDIS_CONTAINER_NAME=redis
# REDIS_URL=redis://redis:6379/
# REDIS_VOLUME_NAME=rsshub-redis-data
# 缓存数据可重建，默认允许 Watchtower 更新 Redis；作为持久状态存储时应改为 false。
# REDIS_WATCHTOWER_ENABLE=true

# RSSHub 应用与浏览器
# 布尔变量通常可用 true/false、1/0；空字符串也会被解析为 false。
# DISALLOW_ROBOT=false
# ENABLE_CLUSTER=false
# 打包构建标记，普通 Docker 部署不要设置。
# IS_PACKAGE=
# NODE_NAME=
# 标准镜像使用远程浏览器时设置；chromium-bundled 镜像通常不需要。
# PLAYWRIGHT_WS_ENDPOINT=
# PUPPETEER_WS_ENDPOINT=  # PLAYWRIGHT_WS_ENDPOINT 的兼容旧名称
# PLAYWRIGHT_CDP_ENDPOINT=
# CHROMIUM_EXECUTABLE_PATH=

# 网络与 HTTP 请求
# PORT 是容器内部监听端口；修改后必须同步修改 Compose 的容器端口和健康检查。
# PORT=1200
# LISTEN_INADDR_ANY=true
# DISABLE_IPV6=false
# REQUEST_RETRY=2
# 单位毫秒；源码默认 30000。
# REQUEST_TIMEOUT=30000
# 留空时使用 RSSHub 默认的随机/浏览器 UA。
# UA=
# true 时使用固定 RSSHub UA；仅在 UA 未设置时生效。
# NO_RANDOM_UA=false
# ALLOW_ORIGIN=

# 缓存
# 可选值：memory、redis、http；空值表示禁用缓存。当前 Compose 固定默认 redis。
# CACHE_TYPE=redis
# HTTP 缓存请求超时，单位秒。
# CACHE_REQUEST_TIMEOUT=60
# 路由缓存和不变内容缓存有效期，单位秒。
# CACHE_EXPIRE=300
# CACHE_CONTENT_EXPIRE=3600
# 内存缓存最大条目数，必须为正整数。
# MEMORY_MAX=256
# REDIS_URL 也属于 Compose 配置，见文件顶部。
# CACHE_HTTP_URL=
# CACHE_HTTP_TOKEN=

# 代理
# 单一代理 URI；例如 http://host:port 或 socks5://host:port。
# PROXY_URI=
# 多代理 URI，使用英文逗号分隔。
# PROXY_URIS=
# 分字段配置代理时使用以下项目。
# PROXY_PROTOCOL=
# PROXY_HOST=
# PROXY_PORT=
# PROXY_AUTH=
# PROXY_URL_REGEX=.*
# 可选值：all、on_retry。
# PROXY_STRATEGY=all
# 故障切换超时和健康检查间隔，单位毫秒。
# PROXY_FAILOVER_TIMEOUT=5000
# PROXY_HEALTH_CHECK_INTERVAL=60000
# PAC_URI=
# PAC_SCRIPT=

# 访问控制
# 设置后，请求需要携带对应访问密钥；不要提交真实值。
# ACCESS_KEY=

# 日志、遥测与错误追踪
# 可选值：true、false 或自定义字符串；自定义字符串需通过 ?debug=<值> 启用。
# DEBUG_INFO=true
# 常用值：trace、debug、info、warn、error、fatal、silent。
# LOGGER_LEVEL=info
# NO_LOGFILES=false
# OTEL_SECONDS_BUCKET=0.01,0.1,1,2,5,15,30,60
# OTEL_MILLISECONDS_BUCKET=10,20,50,100,250,500,1000,5000,15000
# SHOW_LOGGER_TIMESTAMP=false
# HONEYBADGER_API_KEY=
# ERROR_TRACKING_ROUTE_TIMEOUT=30000
# SENTRY=
# SENTRY_ROUTE_TIMEOUT=30000
# ENABLE_REMOTE_DEBUGGING=false

# Feed 输出
# HOTLINK_TEMPLATE=
# 英文逗号分隔的路由路径列表。
# HOTLINK_INCLUDE_PATHS=
# HOTLINK_EXCLUDE_PATHS=
# ALLOW_USER_HOTLINK_TEMPLATE=false
# 可选值：re2、regexp；regexp 允许原生正则能力，但会增加 ReDoS 风险。
# FILTER_REGEX_ENGINE=re2
# ALLOW_USER_SUPPLY_UNSAFE_DOMAIN=false
# DISABLE_NSFW=false
# SUFFIX=
# TITLE_LENGTH_LIMIT=150
# 默认值为 rss；也可按 RSSHub 支持的输出格式设置，例如 atom、json。
# FORMAT=rss

# OpenAI 摘要与翻译
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-3.5-turbo-16k
# 源码默认 0.2；显式环境变量使用整数解析，保留默认值时不要设置此项。
# 如需覆盖请填写整数，例如 1；填写 0.2 会被解析为 0。
# OPENAI_TEMPERATURE=1
# 0 表示不显式限制。
# OPENAI_MAX_TOKENS=0
# OPENAI_API_ENDPOINT=https://api.openai.com/v1
# 常用值：description、content。
# OPENAI_INPUT_OPTION=description
# OPENAI_PROMPT=Please summarize the following article and reply with markdown format.
# OPENAI_PROMPT_TITLE=Please translate the following title into Simplified Chinese and reply only translated text.

# RSSHub Follow
# FOLLOW_OWNER_USER_ID=
# FOLLOW_DESCRIPTION=
# FOLLOW_PRICE=
# FOLLOW_USER_LIMIT=

# 路由专用配置
# 未使用的路由变量应保持注释。Cookie、密码、token、secret 和 API key 均留空。

# 百度
# BAIDU_COOKIE=

# 哔哩哔哩
# 动态格式：BILIBILI_COOKIE_<UID>=<cookie>。
# BILIBILI_COOKIE_114145696=
# BILIBILI_COOKIE_145239325=
# BILIBILI_COOKIE_3546962271930704=
# BILIBILI_DM_IMG_LIST=
# BILIBILI_DM_IMG_INTER=
# BILIBILI_EXCLUDE_SUBTITLES=false

# Bitbucket、北邮人和北邮门户
# BITBUCKET_USERNAME=
# BITBUCKET_PASSWORD=
# BTBYR_HOST=
# BTBYR_COOKIE=
# BUPT_PORTAL_COOKIE=

# 财新、Civitai、大众点评、滴答清单
# CAIXIN_COOKIE=
# CIVITAI_COOKIE=
# DIANPING_COOKIE=
# DIDA365_USERNAME=
# DIDA365_PASSWORD=

# Discord、Discourse、Discuz、Disqus
# DISCORD_AUTHORIZATION=
# 动态格式：DISCOURSE_CONFIG_<ID>=<JSON 对象>。
# DISCOURSE_CONFIG_EXAMPLE=
# 动态格式：DISCUZ_COOKIE_<ID>=<cookie>。
# DISCUZ_COOKIE_EXAMPLE=
# DISQUS_API_KEY=

# 豆瓣、E-Hentai、电子邮件
# DOUBAN_COOKIE=
# EH_IPB_MEMBER_ID=
# EH_IPB_PASS_HASH=
# EH_SK=
# EH_IGNEOUS=
# EH_STAR=
# EH_IMG_PROXY=
# 动态格式：EMAIL_CONFIG_<ID>=<邮箱连接配置>。
# EMAIL_CONFIG_EXAMPLE=

# Etherscan、F95Zone、Fanbox、饭否、Fantia
