# 来源：https://qd-today.github.io/qd/zh_CN/guide/deployment.html；https://hub.docker.com/r/qdtoday/qd
# Docker Compose 环境变量示例

# 必填密钥
# 首次部署时分别生成随机长字符串；已有数据必须继续使用原值，否则 Cookie 或已加密变量失效。
AES_KEY=
COOKIE_SECRET=

# Compose 可选配置
# QD 镜像 tag：latest、lite-latest、ja3-latest、dev 或发布日期版本（20xxxxxx）。
# QD_IMAGE_TAG=latest
# QD_CONTAINER_NAME=qd
# BIND_ADDRESS=0.0.0.0
# QD_HOST_PORT=8923
# MNT_DIR=/mnt/docker
# QD_WATCHTOWER_ENABLE=true
# VALKEY_IMAGE_TAG=9
# VALKEY_CONTAINER_NAME=valkey
# 默认使用命名卷 qd-valkey-data；也可改为绝对宿主机目录。
# VALKEY_DATA_PATH=qd-valkey-data
# VALKEY_VOLUME_NAME=qd-valkey-data
# VALKEY_WATCHTOWER_ENABLE=true

# Web 服务
# 以下布尔变量可选值均为 True、False。
# QD_DEBUG=False
# 容器内监听地址。
# BIND=0.0.0.0
# 官方镜像固定使用 80；修改时必须同步修改 Compose 的容器端口映射。
# PORT=80
# 实验性多进程模式；Windows 平台无效。
# MULTI_PROCESS=False
# 自动热加载；MULTI_PROCESS=True 时无效。
# AUTO_RELOAD=False
# GZIP=True
# ACCESS_LOG=True
# DISPLAY_IMPORT_WARNING=True
# 第一个注册用户是否成为管理员。
# USER0ISADMIN=True
# STATIC_URL_PREFIX=/static/
# 用于密码重置邮件和推送链接；填写域名或 IP:端口，不含 http:// 或 https://。
# DOMAIN=

# Cookie 与加密
# COOKIE_DAY=5
# 仅通过 HTTPS 访问时启用，否则浏览器将无法设置登录 Cookie。
# COOKIE_SECURE_MODE=False
# PBKDF2 迭代次数；已有部署不建议随意修改。
# PBKDF2_ITERATIONS=400

# 数据库
# 可选值：sqlite3、mysql。当前 Compose 持久化 SQLite 配置目录。
# DB_TYPE=sqlite3
# 仅 DB_TYPE=mysql 时填写，密码不要提交到仓库。
# 格式：mysql://用户名:密码@hostname:3306/数据库名?auth_plugin=
# auth_plugin 常见值：mysql_native_password、caching_sha2_password。
# JAWSDB_MARIA_URL=
# 日志级别常见值：DEBUG、INFO、WARNING、ERROR、CRITICAL。
# QD_SQL_LOGGING_NAME=QD.sql
# QD_SQL_LOGGING_LEVEL=WARNING
# QD_SQL_POOL_LOGGING_NAME=QD.sql.pool
# QD_SQL_POOL_LOGGING_LEVEL=WARNING
# QD_SQL_POOL_SIZE=10
# QD_SQL_MAX_OVERFLOW=50
# QD_SQL_POOL_PRE_PING=True
# QD_SQL_POOL_RECYCLE=3600
# QD_SQL_POOL_TIMEOUT=60
# QD_SQL_POOL_USE_LIFO=True

# Valkey / Redis
# 默认连接内置 Valkey；可改为外部 Redis URL，并按需删除 valkey 服务和依赖。
# REDISCLOUD_URL=redis://valkey:6379
# REDIS_DB_INDEX=1
# Redis 可用时的登录或验证失败累计封禁阈值。
# QD_EVIL=500
# 是否对私有地址和 Localhost API 请求跳过上述限制。
# EVIL_PASS_LAN_IP=True

# 任务调度
# 可选值：Queue、Batch；仅 Queue 失效时使用旧版 Batch。
# WORKER_METHOD=Queue
# QUEUE_NUM=50
# Worker 检查间隔，单位毫秒。
# CHECK_TASK_LOOP=500
# TASK_MAX_RETRY_COUNT=8
# NEW_TASK_DELAY=1
# 单个 While 循环超时，单位秒。
# TASK_WHILE_LOOP_TIMEOUT=900
# 单个任务最大请求次数。
# TASK_REQUEST_LIMIT=1500

# HTTP 请求
# 单次下载大小上限，单位字节。
# DOWNLOAD_SIZE_LIMIT=5242880
# REQUEST_TIMEOUT=30.0
# CONNECT_TIMEOUT=30.0
# 延时 API 最大时间应小于 REQUEST_TIMEOUT。
# DELAY_MAX_TIMEOUT=29.9
# unsafe_eval 最大执行时间，单位秒。
# UNSAFE_EVAL_TIMEOUT=3.0
# USE_PYCURL=True
# ALLOW_RETRY=True
# 仅 PyCurl 模式使用，例如 8.8.8.8。
# DNS_SERVER=
# CURL_ENCODING=True
# CURL_CONTENT_LENGTH=True
# 使用 | 分隔不触发降级重试的 HTTP 状态码。
# NOT_RETRY_CODE=301|302|303|304|305|307|400|401|403|404|405|407|408|409|410|412|415|413|414|500|501|502|503|504|599
# EMPTY_RETRY=True

# 日志与推送
# 默认值在 QD_DEBUG=True 时为 True，否则为 False。
# TRACEBACK_PRINT=False
# PUSH_PIC_URL=https://gitee.com/qd-today/qd/raw/master/web/static/img/push_pic.png
# PUSH_BATCH_SW=True
# 定期推送任务日志的检查间隔，单位秒。
# PUSH_BATCH_DELTA=60

# WebSocket
# WS_PING_INTERVAL=5
# 当前源码默认值为 5；官方部署表中的 30 已与源码不一致。
# WS_PING_TIMEOUT=5
# WS_MAX_MESSAGE_SIZE=10485760
# WS_MAX_QUEUE_SIZE=100
# WS_MAX_CONNECTIONS_SUBSCRIBE=30

# 公共模板订阅
# 可选值：jsdelivr_cdn、jsdelivr_fastly、ghproxy、gh-proxy 或自定义代理前缀 URL。
# SUBSCRIBE_ACCELERATE_URL=gh-proxy

# 全局代理
# 多个代理使用 | 分隔，格式：scheme://username:password@host:port。
# PROXIES=
# 可选值：regexp、url、空值；默认 regexp 会阻止本机和回环地址走代理。
# PROXY_DIRECT_MODE=regexp
# regexp 模式已有内置的本机/回环地址规则；保持注释即可使用，不建议设为空。
# PROXY_DIRECT=

# 记事本与 OCR
# NOTEPAD_LIMIT=20
# 自定义 ONNX 文件放在持久化 config 目录，名称不含 .onnx；多个名称用 | 分隔。
# EXTRA_ONNX_NAME=
# 对应字符集文件名称不含 .json；多个名称用 | 分隔。
# EXTRA_CHARSETS_NAME=

# SMTP 邮件
# MAIL_SMTP=
# MAIL_PORT=465
# MAIL_SSL=True
# MAIL_STARTTLS=False
# MAIL_USER=
# 邮箱密码属于敏感值，不要提交真实值。
# MAIL_PASSWORD=
# 未设置时使用 MAIL_USER。
# MAIL_FROM=
# 仅控制邮件链接是否使用 HTTPS，不为 QD 自身启用 TLS。
# MAIL_DOMAIN_HTTPS=False
# 兼容旧配置，同样只影响邮件链接；通常使用 MAIL_DOMAIN_HTTPS 即可。
# ENABLE_HTTPS=False

# Mailgun
# API Key 属于敏感值，不要提交真实值；非空时优先使用 Mailgun。
# MAILGUN_KEY=
# 未设置时使用 DOMAIN。
# MAILGUN_DOMAIN=

# Google Analytics
# 格式示例：G-XXXXXXXXXX；留空禁用。
# GA_KEY=
