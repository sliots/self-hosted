# 来源：https://github.com/cloudflare/cloudflared；https://hub.docker.com/r/cloudflare/cloudflared
# Compose 配置
# CONTAINER_NAME=cloudflared
# IMAGE_TAG=2026.8.2
# WATCHTOWER_ENABLE=true

# 必填：从 Cloudflare Zero Trust 控制台获取的远程托管隧道 token
TUNNEL_TOKEN=

# 传输与连接
# 可选值：auto、http2、quic
TUNNEL_TRANSPORT_PROTOCOL=quic
# TUNNEL_EDGE_IP_VERSION=4
# TUNNEL_EDGE_BIND_ADDRESS=
# TUNNEL_DNS_RESOLVER_ADDRS=
# TUNNEL_REGION=
# TUNNEL_RETRIES=5
# TUNNEL_GRACE_PERIOD=30s
# TUNNEL_POST_QUANTUM=false

# 日志与监控
# TUNNEL_LOGLEVEL=info
# TUNNEL_LOGFILE=
# TUNNEL_METRICS=
# TUNNEL_PIDFILE=

# 元数据
# TUNNEL_TAG=

# Compose command 已固定 --no-autoupdate，无需额外设置。
# NO_AUTOUPDATE=true
