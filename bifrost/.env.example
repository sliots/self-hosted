# 来源：https://docs.getbifrost.ai/quickstart/gateway/setting-up
# Docker Compose 环境变量示例

# Compose 可选配置
# BIFROST_IMAGE_TAG=latest
# BIND_ADDRESS=0.0.0.0
# CONTAINER_NAME=bifrost
# MNT_DIR=/mnt/docker
# PORT=8080
# WATCHTOWER_ENABLE=true

# Bifrost Gateway
# 当前 Compose 固定以下两项，确保容器监听地址与端口映射一致。
# APP_HOST=0.0.0.0
# APP_PORT=8080
# LOG_LEVEL 可选值：debug、info、warn、error。
# LOG_LEVEL=info
# LOG_STYLE 可选值：pretty、json。
# LOG_STYLE=json

# Go 运行时调优
# 垃圾回收目标百分比；Go 默认值为 100，高吞吐场景可参考官方示例设为 200。
# GOGC=100
# 建议设置为容器内存限制的约 90%，例如 3600MiB；未限制内存时保持注释。
# GOMEMLIMIT=
