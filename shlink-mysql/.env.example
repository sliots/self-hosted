# 来源：https://shlink.io/documentation/install-docker-image/；https://shlink.io/documentation/environment-variables/
# Docker Compose 环境变量示例（外部 MySQL）

# Compose 必填配置
# 仅填写短域名，不要包含协议、路径或尾随斜杠，例如 s.example.com。
DEFAULT_DOMAIN=
# 外部 MySQL 用户密码；请使用随机强密码，不要提交真实值。
DB_PASSWORD=

# Compose 可选配置
# stable 始终指向最新稳定版；latest 可能包含 alpha 或 beta 版本。
# SHLINK_IMAGE_TAG=stable
# SHLINK_CONTAINER_NAME=shlink
# BIND_ADDRESS=0.0.0.0
# SHLINK_HOST_PORT=8080
# SHLINK_WATCHTOWER_ENABLE=true

# Shlink 基础配置
# 是否通过 HTTPS 对外提供服务；Shlink 不会自行配置 TLS，通常由反向代理终止 TLS。
# IS_HTTPS_ENABLED=true
# 留空会完全禁用访问地理定位；不要提交真实许可证密钥。
# GEOLITE_LICENSE_KEY=
# 必须以 / 开头；根路径部署时保持未设置。
# BASE_PATH=
# Docker 镜像默认 UTC；数据库也建议保持 UTC。
# TIMEZONE=UTC
# 多实例共享缓存时，每个独立 Shlink 集群应使用唯一命名空间。
# CACHE_NAMESPACE=Shlink
# 反向代理数量，或以英文逗号分隔的固定 IP、CIDR、通配地址。
# TRUSTED_PROXIES=
# 支持字节数或 K、M、G 后缀，-1 表示不限制；官方当前默认 512M。
# MEMORY_LIMIT=512M
# 可选值：console、json。
# LOGS_FORMAT=console

# 短链接生成
# 最小值为 4，小于 4 时会回退为 4。
# DEFAULT_SHORT_CODES_LENGTH=5
# 达到此访问量的短链接禁止删除；留空表示不限制删除。
# DELETE_SHORT_URL_THRESHOLD=
# AUTO_RESOLVE_TITLES=true
# MULTI_SEGMENT_SLUGS_ENABLED=false
# SHORT_URL_TRAILING_SLASH=false
# 可选值：strict、loose。
# SHORT_URL_MODE=strict

# 数据库
# 当前 Compose 连接外部 MySQL；需要确保 DB_HOST 在容器网络中可解析和访问。
# 可选值：mysql、maria、postgres、mssql、sqlite；生产环境不支持 SQLite。
# DB_DRIVER=mysql
# DB_NAME=shlink
# DB_USER=shlink
# DB_PASSWORD 在文件顶部填写。
# DB_HOST=shlink_db
# MySQL/MariaDB 默认 3306；未使用默认端口时再设置。
# DB_PORT=3306
# 可替代 DB_HOST；仅 mysql、maria、postgres 支持 Unix socket。
# DB_UNIX_SOCKET=
# DB_USE_ENCRYPTION=false

# 重定向
# 可选值：301、302、307、308；307/308 会保留原请求方法。
# REDIRECT_STATUS_CODE=302
# 仅 301/308 重定向使用，单位秒。
# REDIRECT_CACHE_LIFETIME=30
# DEFAULT_INVALID_SHORT_URL_REDIRECT=
# DEFAULT_REGULAR_404_REDIRECT=
# DEFAULT_BASE_URL_REDIRECT=
# 可选值：default、append、ignore。
# REDIRECT_EXTRA_PATH_MODE=default

# 访问跟踪与隐私
# DISABLE_TRACKING=false
# TRACK_ORPHAN_VISITS=true
# 用于跳过跟踪的查询参数名；留空表示关闭此功能。
# DISABLE_TRACK_PARAM=
# 英文逗号分隔的固定 IP、CIDR 或通配地址。
# DISABLE_TRACKING_FROM=
# DISABLE_IP_TRACKING=false
# DISABLE_REFERRER_TRACKING=false
# DISABLE_UA_TRACKING=false
# 设为 false 可能不再符合 GDPR 等隐私法规。
# ANONYMIZE_REMOTE_ADDR=true

# robots.txt
# ROBOTS_ALLOW_ALL_SHORT_URLS=false
# 英文逗号分隔；默认允许所有 User-Agent。
# ROBOTS_USER_AGENTS=*

# 跨域
# 可填写 *、<origin>，或英文逗号分隔的允许来源列表。
# CORS_ALLOW_ORIGIN=*
# CORS_ALLOW_CREDENTIALS=false
# Access-Control-Max-Age，单位秒。
# CORS_MAX_AGE=3600

# 实时更新
# 英文逗号分隔；可选值：NEW_VISIT、NEW_ORPHAN_VISIT、NEW_SHORT_URL_VISIT、NEW_SHORT_URL。
# 留空表示启用集成支持的全部主题。
# REAL_TIME_UPDATES_TOPICS=

# Redis / Valkey 集成
# 多实例部署应配置共享 Redis/Valkey，以共享锁和缓存；服务器以英文逗号分隔。
# REDIS_SERVERS=
# REDIS_SENTINEL_SERVICE=
# 以下用户名和密码仅在使用 Sentinel 时生效。
# REDIS_SERVERS_USER=
# REDIS_SERVERS_PASSWORD=
# REDIS_PUB_SUB_ENABLED=false

# Mercure 集成
# MERCURE_ENABLED=false
# MERCURE_PUBLIC_HUB_URL=
# 未设置内部地址时，会使用公开地址发布消息。
# MERCURE_INTERNAL_HUB_URL=
# MERCURE_JWT_SECRET=

# RabbitMQ 集成
# RABBITMQ_ENABLED=false
# RABBITMQ_HOST=
# RABBITMQ_USE_SSL=false
# RABBITMQ_PORT=5672
# RABBITMQ_USER=
# RABBITMQ_PASSWORD=
# RABBITMQ_VHOST=/

# Matomo 集成
# MATOMO_ENABLED=false
# MATOMO_BASE_URL=
# MATOMO_SITE_ID=
# MATOMO_API_TOKEN=

# Docker 镜像专用配置
# PORT 是容器内部监听端口；修改后必须同步修改 Compose 的容器端口。
# PORT=8080
# 默认为容器可用 CPU 数量。
# WEB_WORKER_NUM=
# TASK_WORKER_NUM=
# true 会跳过启动时的 GeoLite2 下载，首次访问可能暂时无法定位。
# SKIP_INITIAL_GEOLITE_DOWNLOAD=false
# 只在首次启动且没有其他 API key 时创建；后续修改或删除变量不会更新或撤销该 key。
# INITIAL_API_KEY=

# 二维码配置（Shlink 4.5.0 起已弃用）
# 以下变量仍受当前版本支持，仅为兼容旧部署保留，新部署不要依赖此功能。
# 范围 50-1000。
# DEFAULT_QR_CODE_SIZE=300
# 官方默认 0。
# DEFAULT_QR_CODE_MARGIN=0
# 可选值：png、svg。
# DEFAULT_QR_CODE_FORMAT=png
# 可选值：L、M、Q、H；官方默认 l。
# DEFAULT_QR_CODE_ERROR_CORRECTION=l
# DEFAULT_QR_CODE_ROUND_BLOCK_SIZE=true
# QR_CODE_FOR_DISABLED_SHORT_URLS=true
# DEFAULT_QR_CODE_COLOR=#000000
# DEFAULT_QR_CODE_BG_COLOR=#FFFFFF
# DEFAULT_QR_CODE_LOGO_URL=

# 已弃用变量
# Shlink 4.4.0 起使用 REDIRECT_EXTRA_PATH_MODE=append 替代。
# REDIRECT_APPEND_EXTRA_PATH=false

# Secret 文件变量
# Shlink 4.0.0 起，任意变量都可使用对应的 _FILE 后缀读取文件内容，例如
# DB_PASSWORD_FILE=/run/secrets/db_password。当前 Compose 未配置 secrets；如果同时设置
# DB_PASSWORD 和 DB_PASSWORD_FILE，Shlink 会忽略 _FILE 变量。
