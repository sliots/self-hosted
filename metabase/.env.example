# 来源：https://www.metabase.com/docs/latest/installation-and-operation/running-metabase-on-docker；https://www.metabase.com/docs/latest/configuring-metabase/environment-variables
# Compose 必填配置
# Metabase 与 PostgreSQL 共用此密码；请使用随机强密码，不要提交真实值。
POSTGRES_PASSWORD=

# Compose 可选配置
# METABASE_IMAGE_TAG=v0.63.14
# METABASE_CONTAINER_NAME=metabase
# METABASE_HOSTNAME=metabase
# POSTGRES_CONTAINER_NAME=metabase_db
# POSTGRES_IMAGE_TAG=18
# POSTGRES_USER=metabase
# POSTGRES_DB=metabaseappdb
# BIND_ADDRESS=0.0.0.0
# PORT=3000
# MNT_DIR=/mnt/docker
# APP_WATCHTOWER_ENABLE=true
# DB_WATCHTOWER_ENABLE=false

# Docker 镜像专用变量
# 仅在需要让容器用户匹配宿主文件权限时设置 UID/GID。
# MUID=
# MGID=
# Java 时区会影响报表时间；数据库仍建议保持 UTC。
# JAVA_TIMEZONE=Asia/Shanghai

# Metabase 环境变量
# 与 Metabase v0.63.14 官方环境变量文档同步。
# 环境变量会覆盖管理后台中保存的同名设置；未使用的变量请保持注释。
# null 默认值以空值展示，口令、令牌和密钥始终留空。

# Metabase 应用数据库
# 当前 Compose 显式覆盖前六项；修改数据库类型、主机或端口时需同步调整 Compose。
# MB_DB_CONNECTION_URI 可替代多数 MB_DB_*，但当前显式连接项会优先覆盖。
# 可选值：postgres、mysql、h2；当前 Compose 固定为 postgres。
# MB_DB_TYPE=postgres
# MB_DB_DBNAME=metabaseappdb
# MB_DB_PORT=5432
# MB_DB_USER=metabase
# MB_DB_PASS=
# MB_DB_HOST=db
# MB_DB_CONNECTION_URI=
# MB_DB_SSL_CERT=
# MB_DB_AWS_IAM=false
# MB_DB_AZURE_MANAGED_IDENTITY_CLIENT_ID=
# MB_DB_CONNECTION_TIMEOUT_MS=
# MB_DB_QUERY_TIMEOUT_MINUTES=
