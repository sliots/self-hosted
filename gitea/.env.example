# 来源：https://docs.gitea.com/installation/install-with-docker/
# Compose 配置
# BIND_ADDRESS=0.0.0.0
# CONTAINER_NAME=gitea
# GITEA_IMAGE_TAG=1.27.2
# GITEA_PORT=3000
# 同时用于宿主端口映射和 Gitea 生成的 SSH 克隆地址。
# GITEA_SSH_PORT=222
# MNT_DIR=/mnt/docker
# WATCHTOWER_ENABLE=true

# 镜像运行用户
# 镜像默认为 1000:1000，只有在挂载目录需要其他 UID/GID 时才覆盖。
# USER_UID=1000
# USER_GID=1000

# Gitea 支持将任意 app.ini 项写为 GITEA__SECTION__KEY。
# 以下覆盖常用部署项，完整选项以官方 Configuration Cheat Sheet 为准。

# 服务器与外部访问
# GITEA__server__DOMAIN=git.example.com
# GITEA__server__ROOT_URL=https://git.example.com/
# GITEA__server__SSH_DOMAIN=git.example.com
# GITEA__server__PROTOCOL=http
# GITEA__server__HTTP_PORT=3000
# GITEA__server__LOCAL_ROOT_URL=http://localhost:3000/
# GITEA__server__OFFLINE_MODE=false
# GITEA__server__LANDING_PAGE=home

# Git LFS
# GITEA__server__LFS_START_SERVER=true
# GITEA__server__LFS_JWT_SECRET=

# 数据库
# DB_TYPE 常用值：sqlite3、mysql、postgres、mssql。
# GITEA__database__DB_TYPE=sqlite3
# GITEA__database__PATH=/data/gitea/gitea.db
# GITEA__database__HOST=db:3306
# GITEA__database__NAME=gitea
# GITEA__database__USER=gitea
# GITEA__database__PASSWD=
# GITEA__database__SCHEMA=
# GITEA__database__SSL_MODE=disable
# GITEA__database__LOG_SQL=false

# 安装与安全
# 下列密钥留空时不要取消注释；可由 Gitea 首次安装生成。
# GITEA__security__INSTALL_LOCK=true
# GITEA__security__SECRET_KEY=
# GITEA__security__INTERNAL_TOKEN=
# GITEA__oauth2__JWT_SECRET=

# 用户注册与访问
# GITEA__service__DISABLE_REGISTRATION=true
# GITEA__service__REQUIRE_SIGNIN_VIEW=false
# GITEA__service__REGISTER_EMAIL_CONFIRM=false
# GITEA__service__ENABLE_NOTIFY_MAIL=false
# GITEA__service__DEFAULT_ALLOW_CREATE_ORGANIZATION=true
# GITEA__service__DEFAULT_USER_IS_RESTRICTED=false

# 邮件
# PROTOCOL 可选值：smtp、smtps、smtp+starttls、smtp+unix、sendmail、dummy。
# GITEA__mailer__ENABLED=true
# GITEA__mailer__PROTOCOL=smtp+starttls
# GITEA__mailer__SMTP_ADDR=smtp.example.com
# GITEA__mailer__SMTP_PORT=587
# GITEA__mailer__FROM=Gitea <gitea@example.com>
# GITEA__mailer__USER=gitea@example.com
# GITEA__mailer__PASSWD=

# 仓库默认值
# GITEA__repository__DEFAULT_BRANCH=main
# 可选值：last、private、public。
# GITEA__repository__DEFAULT_PRIVATE=last
# GITEA__repository__ENABLE_PUSH_CREATE_USER=false
# GITEA__repository__ENABLE_PUSH_CREATE_ORG=false

# Actions
# GITEA__actions__ENABLED=true
# DEFAULT_ACTIONS_URL 可设为 github、self 或自定义 Actions 镜像地址。
# GITEA__actions__DEFAULT_ACTIONS_URL=github

# Package Registry
# GITEA__packages__ENABLED=true
# GITEA__packages__LIMIT_TOTAL_OWNER_COUNT=-1
# GITEA__packages__LIMIT_SIZE_CONTAINER=-1

# 指标与健康检查
# GITEA__metrics__ENABLED=false
# GITEA__metrics__ENABLED_ISSUE_BY_LABEL=false
# GITEA__metrics__ENABLED_ISSUE_BY_REPOSITORY=false
# GITEA__metrics__TOKEN=
