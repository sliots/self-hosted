# 来源：https://komo.do/docs/setup/mongo；https://komo.do/docs/setup/advanced；https://komo.do/docs/setup/connect-servers
# Compose 必填配置
KOMODO_DATABASE_USERNAME=admin

# 必填：MongoDB 管理员密码，同时供 Komodo Core 连接数据库。
KOMODO_DATABASE_PASSWORD=

# Compose 可选配置
# BIND_ADDRESS=0.0.0.0
# COMPOSE_KOMODO_IMAGE_TAG=2.13.4
# CONFIG_DIR=/mnt/docker/komodo/core.config.toml
# CORE_CONTAINER_NAME=core
# CORE_WATCHTOWER_ENABLE=true
# MNT_DIR=/mnt/docker
# MONGO_CONTAINER_NAME=mongo
# MONGO_IMAGE_TAG=8.0
# MONGO_WATCHTOWER_ENABLE=false
# PORT=9120

# 通用与初始化
# TZ=Etc/UTC
# KOMODO_TITLE=Komodo
# 用于 OAuth 回调、Webhook 和外部链接，例如 https://komodo.example.com。
# KOMODO_HOST=
# 首次启动时创建的服务器；两项需同时设置。
# KOMODO_FIRST_SERVER_NAME=
# KOMODO_FIRST_SERVER_ADDRESS=
# 首次启动时创建的管理员；两项需同时设置。
# KOMODO_INIT_ADMIN_USERNAME=
# KOMODO_INIT_ADMIN_PASSWORD=
# KOMODO_DISABLE_CONFIRM_DIALOG=false
# KOMODO_DISABLE_INIT_RESOURCES=false

# 用户与权限
# KOMODO_ENABLE_NEW_USERS=true
# KOMODO_DISABLE_USER_REGISTRATION=false
# KOMODO_DISABLE_NON_ADMIN_CREATE=false
# KOMODO_ENABLE_USER_UPDATE_CREDENTIALS=false
# KOMODO_TRANSPARENT_MODE=false
# KOMODO_UI_WRITE_DISABLED=false
# KOMODO_DISABLE_EXTERNAL_URLS=false

# Core / Periphery 身份
# 默认使用挂载到 /config/keys 的 Periphery 公钥。
# KOMODO_PERIPHERY_PUBLIC_KEY=file:/config/keys/periphery.pub
# v1 兼容项，新部署不建议使用 passkey。
# KOMODO_PASSKEY=

# 本地认证与会话
# KOMODO_LOCAL_AUTH=true
# 登录失败后锁定时间，例如 1-day。
# KOMODO_LOCK_LOGIN_CREDENTIALS_FOR=1-day
# KOMODO_JWT_TTL=1-day
# 建议在生产环境固定，避免重启后会话失效。
# KOMODO_JWT_SECRET=

# OIDC
# KOMODO_OIDC_ENABLED=false
# KOMODO_OIDC_PROVIDER=https://oidc.provider.internal/application/o/komodo
# KOMODO_OIDC_REDIRECT_HOST=
# KOMODO_OIDC_CLIENT_ID=
# KOMODO_OIDC_CLIENT_SECRET=
# KOMODO_OIDC_USE_FULL_EMAIL=false
# KOMODO_OIDC_ADDITIONAL_AUDIENCES=
# KOMODO_OIDC_LDAP_SERVICE_ACCOUNT=false
# KOMODO_OIDC_LDAP_MAINTAIN_ADMIN=true
# 使用逗号分隔的 OIDC group 名称。
# KOMODO_OIDC_USER_GROUPS=
# KOMODO_OIDC_ADMIN_GROUPS=

# MongoDB
# Compose 已固定为 mongo:27017，.env 中的同名值会被 service environment 覆盖。
# KOMODO_DATABASE_ADDRESS=mongo:27017
# KOMODO_DATABASE_APP_NAME=komodo_core

# Webhook
# KOMODO_WEBHOOK_SECRET=
# KOMODO_WEBHOOK_BASE_URL=
# KOMODO_REPO_WEBHOOKS_ENABLED=true
# KOMODO_STACK_WEBHOOKS_ENABLED=true
# KOMODO_BUILD_WEBHOOKS_ENABLED=true
# KOMODO_PROCEDURE_WEBHOOKS_ENABLED=true
# KOMODO_ACTION_WEBHOOKS_ENABLED=true
# KOMODO_WEBHOOKS_ENABLED=true

# 日志
# KOMODO_LOGGING_LEVEL 可选值：off、error、warn、info、debug、trace。
# KOMODO_LOGGING_LEVEL=info
# KOMODO_LOGGING_STDIO 可选值：none、standard、json。
# KOMODO_LOGGING_STDIO=standard
# KOMODO_LOGGING_PRETTY=false
# KOMODO_LOGGING_OPENTELEMETRY_SERVICE_NAME=Komodo
# KOMODO_LOGGING_OTLP_ENDPOINT=
# KOMODO_LOGGING_LOKI_URL=
# KOMODO_LOGGING_LOKI_LABEL=komodo

# 资源监控周期
# KOMODO_MONITORING_INTERVAL=15-sec
# KOMODO_RESOURCE_POLL_INTERVAL=5-min
# KOMODO_RESOURCE_SYNC_INTERVAL=1-hr
# KOMODO_CLOUD_POLL_INTERVAL=1-hr
# KOMODO_KEEP_STATS_FOR_DAYS=14
# KOMODO_KEEP_ALERTS_FOR_DAYS=14

# 监控功能开关
# KOMODO_ALERTING_ENABLED=true
# KOMODO_MONITORING_ENABLED=true
# KOMODO_SYSTEM_STATS_ENABLED=true
# KOMODO_CONTAINER_STATS_ENABLED=true
# KOMODO_OAUTH_ENABLED=true

# 通知开关
# KOMODO_NOTIFY_REFRESHED_BUILD_UPDATE=false
# KOMODO_NOTIFY_RESOURCE_SYNC_PENDING_UPDATES=false
# KOMODO_NOTIFY_RESOURCE_SYNC_COMPLETE=false
# KOMODO_NOTIFY_PROCEDURE_COMPLETE=false

# GitHub OAuth
# KOMODO_GITHUB_OAUTH_ENABLED=true
# KOMODO_GITHUB_OAUTH_ID=
# KOMODO_GITHUB_OAUTH_SECRET=

# GitLab OAuth
# KOMODO_GITLAB_OAUTH_ENABLED=true
# KOMODO_GITLAB_OAUTH_ID=
# KOMODO_GITLAB_OAUTH_SECRET=

# Git 账号、组织与镜像仓库
# 值的结构和转义规则以 core.config.toml 为准。
# KOMODO_AWS_ECR_REGISTRIES=
# KOMODO_GITHUB_ACCOUNTS=
# KOMODO_GITLAB_ACCOUNTS=
# KOMODO_DOCKER_REGISTRIES=
# KOMODO_GITHUB_ORGANIZATIONS=

# 上游还支持多个 *_FILE 密钥文件替代变量。
# 本仓库当前不挂载 Compose secrets，因此不提供不可直接使用的 *_FILE 赋值。
