# 来源：https://hub.docker.com/_/rabbitmq；https://www.rabbitmq.com/docs/download
# Docker Compose 环境变量示例

# 首次初始化必填
# 使用非 guest 用户和随机强密码；已有数据目录不会因修改这两个值而更新现有用户。
RABBITMQ_DEFAULT_PASS=
RABBITMQ_DEFAULT_USER=

# Compose 可选配置
# 保留现有 3.13.7 默认值，避免未评审的数据升级。
# 截至 2026-08-26，官方镜像当前版本为 4.3.5；从 3.13.x 升级应先到 4.2.x，再到 4.3.x，
# 并在每一步确认稳定 feature flags、插件兼容性、Erlang 要求和备份。
# 可用变体包括 alpine、management、management-alpine，例如 3.13.7-management-alpine。
# RABBITMQ_IMAGE_TAG=3.13.7-alpine
# RABBITMQ_CONTAINER_NAME=rabbitmq
# hostname 决定默认节点名及数据子目录；初始化后不要随意修改。
# RABBITMQ_HOSTNAME=rabbitmq
# BIND_ADDRESS=0.0.0.0
# AMQP_PORT=5672
# management 端口仅在使用 management 镜像 tag 时可用，默认仅绑定本机。
# MANAGEMENT_BIND_ADDRESS=127.0.0.1
# MANAGEMENT_PORT=15672
# 默认使用命名卷 rabbitmq-data；也可改为绝对宿主机目录。
# 从旧 Compose 的匿名卷切换前必须先确认并迁移原有 /var/lib/rabbitmq 数据。
# RABBITMQ_DATA_PATH=rabbitmq-data
# RABBITMQ_VOLUME_NAME=rabbitmq-data
# RABBITMQ_CONFIG_DIR=/mnt/docker/rabbitmq/config
# 消息队列不应由 Watchtower 自动更新。
# RABBITMQ_WATCHTOWER_ENABLE=false

# 默认虚拟主机
# 仅首次初始化空数据目录时创建；已有部署应使用 rabbitmqctl 或 definitions 管理。
# RABBITMQ_DEFAULT_VHOST=/

# 节点与监听
# 容器默认监听所有接口；如修改内部端口，必须同步调整 Compose 端口映射和健康检查。
# RABBITMQ_NODE_IP_ADDRESS=
# RABBITMQ_NODE_PORT=5672
# 节点间及 CLI 分布式通信端口，默认是 RABBITMQ_NODE_PORT + 20000。
# RABBITMQ_DIST_PORT=25672
# epmd 默认监听全部接口。
# ERL_EPMD_ADDRESS=
# ERL_EPMD_PORT=4369
# 节点间通信发送缓冲区，单位 KiB；低于 65536 不建议使用。
# RABBITMQ_DISTRIBUTION_BUFFER_SIZE=128000
# 默认节点名由 hostname 生成，即 rabbit@rabbitmq。
# 显式设置后不得在已有数据目录上随意修改。
# RABBITMQ_NODENAME=rabbit@rabbitmq
# 可选值：true、false。切换长短节点名需要重置节点，不应原位修改。
# RABBITMQ_USE_LONGNAME=false

# 配置文件位置
# 当前 Compose 提供了对应的注释挂载；启用时文件必须存在。
# RABBITMQ_CONFIG_FILE=/etc/rabbitmq/rabbitmq.conf
# 使用按文件名排序的 conf.d 目录时改用本变量，不能同时依赖单文件路径。
# RABBITMQ_CONFIG_FILES=/etc/rabbitmq/conf.d
# RABBITMQ_ADVANCED_CONFIG_FILE=/etc/rabbitmq/advanced.config
# rabbitmq-env.conf 中的键不带 RABBITMQ_ 前缀。
# RABBITMQ_CONF_ENV_FILE=/etc/rabbitmq/rabbitmq-env.conf

# 数据、日志与插件目录
# 官方镜像已将整个 /var/lib/rabbitmq 持久化，通常不应覆盖以下目录变量。
# RABBITMQ_MNESIA_BASE=/var/lib/rabbitmq/mnesia
# 默认值包含节点名，例如 /var/lib/rabbitmq/mnesia/rabbit@rabbitmq。
# RABBITMQ_MNESIA_DIR=
# Docker 镜像默认把日志输出到标准输出，不建议改为容器内日志文件。
# RABBITMQ_LOG_BASE=/var/log/rabbitmq
# 插件目录是使用冒号分隔的路径列表。
# RABBITMQ_PLUGINS_DIR=/opt/rabbitmq/plugins:/var/lib/rabbitmq/plugins
# 插件展开目录通常位于 Mnesia 数据目录旁，不建议覆盖。
# RABBITMQ_PLUGINS_EXPAND_DIR=

# Erlang 运行时
# 最大可用文件描述符首先受宿主机 ulimit 限制；以下变量不能突破硬限制。
# RABBITMQ_MAX_OPEN_FILES=
# ERL_MAX_PORTS=65536
# 仅在调试时使用；SERVER_ERL_ARGS 会完全替换官方默认参数。
# RABBITMQ_SERVER_ERL_ARGS=
# 追加 Erlang 参数时优先使用本变量。
# RABBITMQ_SERVER_ADDITIONAL_ERL_ARGS=
# RABBITMQ_SERVER_START_ARGS=
# RABBITMQ_CTL_ERL_ARGS=
# RABBITMQ_SERVER_CODE_PATH=

# 集群 Erlang Cookie
# 官方建议将 cookie 文件以权限 0600 挂载到 /var/lib/rabbitmq/.erlang.cookie。
# 不使用 RABBITMQ_ERLANG_COOKIE，也不要把真实 cookie 写入本示例。

# 已废弃或不支持的 Docker 专用变量
# RabbitMQ 3.9+ 不再支持 RABBITMQ_DEFAULT_USER_FILE、RABBITMQ_DEFAULT_PASS_FILE、
# RABBITMQ_VM_MEMORY_HIGH_WATERMARK 以及 RABBITMQ_SSL_*、RABBITMQ_MANAGEMENT_SSL_*。
# 用户、TLS、内存水位和其他 broker 设置应写入 rabbitmq.conf 或通过 definitions 初始化。
