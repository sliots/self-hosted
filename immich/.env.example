# 来源：https://docs.immich.app/install/docker-compose/
# 使用 docker compose 时将本文件复制为 .env。
# Portainer Web Editor 会生成 stack.env；它不会自动包含本地 .env。

# Compose 必填配置
UPLOAD_LOCATION=
DB_DATA_LOCATION=

# 必填：数据库密码，不要提交真实值。
DB_PASSWORD=

# Compose 可选配置
# BIND_ADDRESS=0.0.0.0
# PORT=2283
# IMMICH_VERSION=v3.1.0
# IMMICH_SERVER_CONTAINER_NAME=immich_server
# IMMICH_MACHINE_LEARNING_CONTAINER_NAME=immich_machine_learning
# REDIS_CONTAINER_NAME=immich_redis
# DATABASE_CONTAINER_NAME=immich_postgres
# IMMICH_SERVER_WATCHTOWER_ENABLE=true
# IMMICH_MACHINE_LEARNING_WATCHTOWER_ENABLE=true
# REDIS_WATCHTOWER_ENABLE=true
# DATABASE_WATCHTOWER_ENABLE=false

# 通用运行配置
# TZ=Etc/UTC
# IMMICH_ENV 可选值：production、development。
# IMMICH_ENV=production
# 使用自定义 YAML/JSON 配置文件时，路径必须在容器内可读。
# IMMICH_CONFIG_FILE=
# IMMICH_CONFIG_DIR=./
# IMMICH_LOG_LEVEL 可选值：verbose、debug、log、warn、error。
# IMMICH_LOG_LEVEL=log
# 媒体在容器内的路径，Compose 挂载目标会与此值同步。
# IMMICH_MEDIA_LOCATION=/data
# IMMICH_IGNORE_MOUNT_CHECK_ERRORS=false
# 逗号分隔的 IP 或 CIDR，仅信任实际反向代理地址。
# IMMICH_TRUSTED_PROXIES=
# IMMICH_API_METRICS_PORT=8081
# IMMICH_PROCESS_INVALID_IMAGES=false

# API 与网络
# IMMICH_HOST=0.0.0.0
# IMMICH_PORT=2283
# IMMICH_API_URL_EXTERNAL=
# IMMICH_API_URL_INTERNAL=
# IMMICH_MACHINE_LEARNING_URL 已弃用，新配置使用 IMMICH_MACHINE_LEARNING_URL_INTERNAL。
# IMMICH_MACHINE_LEARNING_URL=
# IMMICH_MACHINE_LEARNING_URL_INTERNAL=http://immich-machine-learning:3003
# IMMICH_MACHINE_LEARNING_ENABLED=true

# PostgreSQL
# DB_HOSTNAME=database
# DB_USERNAME=postgres
# DB_DATABASE_NAME=immich
# DB_PORT=5432
# DB_VECTOR_EXTENSION 可选值：vectorchord、pgvectors。
# DB_VECTOR_EXTENSION=vectorchord
# DB_SKIP_MIGRATIONS=false
# 设置 DB_URL 时优先于上述独立数据库变量。
# DB_URL=

# 数据库存储介质
# 数据库位于 HDD 时设为 HDD；SSD 时保持未设置。
# DB_STORAGE_TYPE=HDD

# Redis / Valkey
# REDIS_HOSTNAME=redis
# REDIS_PORT=6379
# REDIS_USERNAME=
# REDIS_PASSWORD=
# REDIS_DBINDEX=0
# 设置 REDIS_URL 时优先于独立主机、端口和认证变量。
# REDIS_URL=
# REDIS_SOCKET=
# REDIS_SOCKET_TIMEOUT=0

# Server worker
# 可选 worker 名称：api、microservices，使用逗号分隔。
# IMMICH_WORKERS_INCLUDE=
# IMMICH_WORKERS_EXCLUDE=

# Machine Learning 运行参数
# 模型空闲超时，单位秒；0 表示不卸载。
# MACHINE_LEARNING_MODEL_TTL=300
# MACHINE_LEARNING_MODEL_TTL_POLL_S=10
# MACHINE_LEARNING_CACHE_FOLDER=/cache
# MACHINE_LEARNING_REQUEST_THREADS=0
# MACHINE_LEARNING_WORKERS=1
# MACHINE_LEARNING_WORKER_TIMEOUT=120

# Machine Learning 模型预加载
# 各项使用逗号分隔的模型名称。
# MACHINE_LEARNING_PRELOAD__CLIP__TEXTUAL=
# MACHINE_LEARNING_PRELOAD__CLIP__VISUAL=
# MACHINE_LEARNING_PRELOAD__FACIAL_RECOGNITION__DETECTION=
# MACHINE_LEARNING_PRELOAD__FACIAL_RECOGNITION__RECOGNITION=

# OAuth / OIDC
# OAUTH_ENABLED=false
# OAUTH_ISSUER_URL=
# OAUTH_CLIENT_ID=
# OAUTH_CLIENT_SECRET=
# OAUTH_SCOPE=openid email profile
# OAUTH_AUTO_REGISTER=true
# OAUTH_AUTO_LAUNCH=false
# OAUTH_BUTTON_TEXT=Login with OAuth
# OAUTH_STORAGE_LABEL_CLAIM=immich_storage_label
# OAUTH_ROLE_CLAIM=immich_role
# OAUTH_STORAGE_QUOTA_CLAIM=immich_quota
# OAUTH_DEFAULT_STORAGE_QUOTA=0

# Telemetry
# 值可使用 all，或从 host、api、io、repo、jobs 中选择并以逗号分隔。
# IMMICH_TELEMETRY_INCLUDE=all
# IMMICH_TELEMETRY_EXCLUDE=

# 上游还支持 DB_PASSWORD_FILE、REDIS_PASSWORD_FILE 和 OAUTH_CLIENT_SECRET_FILE。
# 本仓库当前不挂载 Compose secrets，因此不在此提供不可直接使用的配置项。
