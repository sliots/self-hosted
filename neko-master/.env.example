# 来源：https://github.com/foru17/neko-master

# Compose 必填配置
# Cookie 签名密钥，建议至少 32 字节随机值；不要提交真实值。
COOKIE_SECRET=

# Compose 可选配置
# IMAGE_TAG=latest
# CONTAINER_NAME=neko-master
# BIND_ADDRESS=0.0.0.0
# WEB_EXTERNAL_PORT=3000
# API_EXTERNAL_PORT=3001
# WS_EXTERNAL_PORT=3002
# MNT_DIR=/mnt/docker
# WATCHTOWER_ENABLE=true

# 容器内部端口与数据路径
# 镜像已提供以下默认值；修改时必须同步调整 ports、healthcheck 或 volumes。
# WEB_PORT=3000
# API_PORT=3001
# COLLECTOR_WS_PORT=3002
# DB_PATH=/app/data/stats.db
# NODE_ENV=production

# Web 运行时地址
# 反向代理部署可填写完整 URL；留空时使用当前页面主机及外部端口。
# NEXT_PUBLIC_API_URL=
# NEXT_PUBLIC_WS_URL=

# 访问控制
# 逗号分隔的 Origin；同源部署保持为空，默认拒绝跨源请求。
# CORS_ORIGIN=
# 紧急恢复开关：true 会强制关闭访问控制，仅在无法登录时临时启用。
# FORCE_ACCESS_CONTROL_OFF=false
# true 会禁止修改配置、认证设置和数据操作。
# SHOWCASE_SITE_MODE=false

# GeoIP
# GEOIP_LOOKUP_PROVIDER 可选值：online、local。
# GEOIP_LOOKUP_PROVIDER=online
# GEOIP_ONLINE_API_URL=https://api.ipinfo.es/ipinfo
# 当前只读挂载目录；local 模式下在此放置 GeoLite2-City.mmdb 等文件。
# GEOIP_MMDB_DIR=/app/data/geoip
# 本地查询最小间隔与指标日志周期，单位毫秒。
# GEOIP_LOCAL_MIN_REQUEST_INTERVAL_MS=10
# GEOIP_METRICS_LOG_INTERVAL_MS=60000
# 城市库没有国家信息时回退查询 GeoLite2-Country.mmdb。
# GEOIP_ENABLE_COUNTRY_MMDB_FALLBACK=false

# Gateway WebSocket
# 心跳、静默超时、重连上限和指标日志周期，单位毫秒。
# WS_HEARTBEAT_INTERVAL_MS=10000
# WS_HEARTBEAT_TIMEOUT_MS=30000
# WS_MAX_RECONNECT_INTERVAL_MS=60000
# WS_METRICS_LOG_INTERVAL_MS=60000
# 慢客户端的最大出站缓冲字节数。
# WS_MAX_BUFFERED_BYTES=4194304

# 采集与实时数据
# 批量写入周期、最大缓冲记录数及实时内存窗口。
# FLUSH_INTERVAL_MS=30000
# FLUSH_MAX_BUFFER_SIZE=5000
# REALTIME_MAX_MINUTES=180
# RULE_CHAIN_FLOW_MAX_ROWS=2000
# BACKEND_HEALTH_CHECK_INTERVAL_MS=30000
# Surge 策略同步周期，单位毫秒；调试日志通常保持关闭。
# SURGE_POLICY_SYNC_INTERVAL_MS=600000
# DEBUG_SURGE=false

# Neko Agent 接入
# 服务端强制接受的最低 Agent 协议和版本；留空版本表示不限制。
# MIN_AGENT_PROTOCOL_VERSION=1
# MIN_AGENT_VERSION=
# AGENT_HEARTBEAT_TIMEOUT_MS=30000
# AGENT_MANUAL_TEST_TIMEOUT_MS=8000
# AGENT_FLUSH_INTERVAL_MS=30000
# AGENT_INGEST_MAX_BATCH_SIZE=5000

# SQLite 与查询缓存
# SQLITE_CACHE_MB=64
# SQLITE_WAL_AUTOCHECKPOINT_PAGES=1000
# SQLITE_BUSY_TIMEOUT_MS=5000
# DB_RANGE_QUERY_CACHE_TTL_MS=8000
# DB_HISTORICAL_QUERY_CACHE_TTL_MS=300000
# REALTIME_RANGE_END_TOLERANCE_MS=120000
# DB_RANGE_QUERY_CACHE_MAX_ENTRIES=1024
# 设为 1 禁用范围查询缓存。
# DB_RANGE_QUERY_CACHE_DISABLED=0
# STATS_ROUTE_METRICS_LOG_INTERVAL_MS=60000

# ClickHouse
# 当前 Compose 不启动 ClickHouse；启用前需要准备可访问的外部实例。
# 布尔型 ClickHouse 开关使用 0 或 1。
# CH_ENABLED=0
# CH_REQUIRED=0
# CH_SECURE=0
# CH_HOST=clickhouse
# CH_PORT=8123
# CH_DATABASE=neko_master
# CH_USER=default
# CH_PASSWORD=
# CH_CONNECT_TIMEOUT_MS=5000
# CH_CONNECT_MAX_RETRIES=5
# CH_CONNECT_RETRY_DELAY_MS=2000

# ClickHouse 写入与建表
# CH_WRITE_ENABLED=0
# CH_WRITE_MAX_PENDING_BATCHES=200
# CH_WRITE_MAX_PENDING_ROWS=200000
# CH_AUTO_CREATE_TABLES=1
# CH_UNHEALTHY_THRESHOLD=5
# CH_METRICS_LOG_INTERVAL_MS=60000
# CH_BACKEND_CLEAR_RETRY_DELAY_MS=70000

# ClickHouse 查询和迁移核对
# STATS_QUERY_SOURCE 可选值：sqlite、clickhouse、auto。
# STATS_QUERY_SOURCE=sqlite
# 仅使用 ClickHouse，跳过 SQLite 写入。
# CH_ONLY_MODE=0
# CH_DISABLE_SQLITE_REDUCTION=0
# CH_STRICT_STATS=0
# CH_COMPARE_ENABLED=0
# CH_COMPARE_INTERVAL_MS=120000
# CH_COMPARE_WINDOW_MINUTES=10
# CH_COMPARE_TIMEOUT_MS=8000
# CH_COMPARE_START_DELAY_MS=120000
# 核对脚本允许的差异百分比，以及超出差异时是否返回失败。
# CH_VERIFY_MAX_DELTA_PERCENT=1
# CH_VERIFY_FAIL_ON_DELTA=0
