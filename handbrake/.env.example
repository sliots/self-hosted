# 来源：https://github.com/jlesage/docker-handbrake
# Compose 配置
# BIND_ADDRESS=0.0.0.0
# CONTAINER_NAME=handbrake
# IMAGE_TAG=v26.08.2
# MNT_DIR=/mnt/docker
# PORT=5800
# 仅在 Compose 中取消注释 VNC 端口映射后使用。
# VNC_PORT=5900
# WATCHTOWER_ENABLE=true

# 运行用户与文件权限
# USER_ID=1000
# GROUP_ID=1000
# 附加组 ID 使用逗号分隔，可用于授予 GPU 设备组权限。
# SUP_GROUP_IDS=
# UMASK=0022

# 语言与时区
# LANG=en_US.UTF-8
# TZ=Etc/UTC
# ENABLE_CJK_FONT=0

# 容器运行行为
# KEEP_APP_RUNNING=0
# 可用范围为 -20 至 19；负值需要额外的 SYS_NICE capability。
# APP_NICENESS=0
# 临时安装的 Alpine 软件包，使用空格分隔。
# INSTALL_PACKAGES=
# PACKAGES_MIRROR=
# CONTAINER_DEBUG=0

# 显示与界面
# DISPLAY_WIDTH=1920
# DISPLAY_HEIGHT=1080
# DARK_MODE=0
# WEB_AUDIO=0
# WEB_HOST_CLIPBOARD_SYNC=1
# WEB_NOTIFICATION=0
# HANDBRAKE_GUI=1
# HANDBRAKE_DEBUG=0
# 可选值：NONE、PROCESS、CLEAR。
# HANDBRAKE_GUI_QUEUE_STARTUP_ACTION=NONE

# Web 文件管理器
# WEB_FILE_MANAGER=0
# 可设为 AUTO、ALL 或逗号分隔的容器路径。
# WEB_FILE_MANAGER_ALLOWED_PATHS=AUTO
# WEB_FILE_MANAGER_DENIED_PATHS=

# Web 终端
# WEB_TERMINAL=0
# WEB_TERMINAL_SHELL_PATH=/bin/sh

# Web 认证
# 官方建议仅在 SECURE_CONNECTION=1 时启用。
# WEB_AUTHENTICATION=0
# 允许在明文 HTTP 中使用认证，不建议启用。
# WEB_AUTHENTICATION_ALLOW_INSECURE=0
# WEB_AUTHENTICATION_TOKEN_VALIDITY_TIME=24
# WEB_AUTHENTICATION_USERNAME=
# WEB_AUTHENTICATION_PASSWORD=

# HTTPS 与加密 VNC
# 证书放置在 /config/certs 后再启用。
# SECURE_CONNECTION=0
# SECURE_CONNECTION_VNC_METHOD 可选值：SSL、TLS。
# SECURE_CONNECTION_VNC_METHOD=SSL
# SECURE_CONNECTION_CERTS_CHECK_INTERVAL=60

# Web / VNC 监听
# 设为 1 时仅允许容器 localhost 连接。
# WEB_LOCALHOST_ONLY=0
# VNC_LOCALHOST_ONLY=0
# 设为 -1 可禁用对应服务。
# WEB_LISTENING_PORT=5800
# VNC_LISTENING_PORT=5900
# VNC_PASSWORD=

# 自动转换基础配置
# AUTOMATED_CONVERSION=1
# PRESET 格式为 <CATEGORY>/<PRESET NAME>。
# AUTOMATED_CONVERSION_PRESET=General/Very Fast 1080p30
# AUTOMATED_CONVERSION_FORMAT=mp4
# 设为 0 时，转换成功后会删除或移动源文件。
# AUTOMATED_CONVERSION_KEEP_SOURCE=1
# AUTOMATED_CONVERSION_OVERWRITE_OUTPUT=0
# AUTOMATED_CONVERSION_NO_GUI_PROGRESS=0
# AUTOMATED_CONVERSION_HANDBRAKE_CUSTOM_ARGS=

# 文件类型
# 限制可转换的扩展名，留空时由 HandBrake 自动检测。
# AUTOMATED_CONVERSION_VIDEO_FILE_EXTENSIONS=
# 非视频文件处理可选值：ignore、copy。
# AUTOMATED_CONVERSION_NON_VIDEO_FILE_ACTION=ignore
# AUTOMATED_CONVERSION_NON_VIDEO_FILE_EXTENSIONS=jpg jpeg bmp png gif txt nfo

# 输入与输出目录
# AUTO 会依次使用 /watch、/watch2、/watch3 等路径。
# AUTOMATED_CONVERSION_WATCH_DIR=AUTO
# AUTOMATED_CONVERSION_OUTPUT_DIR=/output
# 可填子目录，或使用 SAME_AS_SRC 保留源目录结构。
# AUTOMATED_CONVERSION_OUTPUT_SUBDIR=

# 源文件检测
# AUTOMATED_CONVERSION_SOURCE_STABLE_TIME=5
# AUTOMATED_CONVERSION_SOURCE_MIN_DURATION=10
# AUTOMATED_CONVERSION_SOURCE_MAIN_TITLE_DETECTION=0
# AUTOMATED_CONVERSION_CHECK_INTERVAL=5
# AUTOMATED_CONVERSION_MAX_WATCH_FOLDERS=5

# 回收站
# 启用前建议在 Compose 中取消注释 /trash 挂载。
# AUTOMATED_CONVERSION_USE_TRASH=0
# AUTOMATED_CONVERSION_TRASH_DIR=/trash

# 多 watch 目录可在所有 AUTOMATED_CONVERSION_* 变量后追加 _2、_3 等索引，
# 例如 AUTOMATED_CONVERSION_PRESET_2=General/Fast 1080p30。
