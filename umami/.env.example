# Docker Compose 环境变量示例

# 必填变量
POSTGRES_PASSWORD=

# 无默认值，按部署需要填写
DB_PORT=

# 可选变量及当前安全默认值
# BIND_ADDRESS=0.0.0.0
# CLOUD_MODE=1
# DB_CONTAINER_NAME=db
# DB_WATCHTOWER_ENABLE=false
# DISABLE_LOGIN=1
# DISABLE_TELEMETRY=1
# DISABLE_TEST_CONSOLE=0
# DISABLE_UPDATES=1
# IMAGE_TAG=postgresql-v2
# MNT_DIR=/mnt/docker
# PORT=3000
# POSTGRES_DB=umami
# POSTGRES_IMAGE_TAG=18
# POSTGRES_USER=umami
# UMAMI_CONTAINER_NAME=umami
# UMAMI_WATCHTOWER_ENABLE=true
