# 来源：https://github.com/snowdreamtech/frp
# Compose 配置
# CONTAINER_NAME=frps
# IMAGE_TAG=0.71.0-debian
# MNT_DIR=/mnt/docker
# WATCHTOWER_ENABLE=true

# 镜像运行环境
# KEEPALIVE=0
# CAP_NET_BIND_SERVICE=0
# LANG=C.UTF-8
# UMASK=022
# DEBUG=false
# TZ=Asia/Shanghai

# 运行用户
# 仅在 PUID、PGID 非 0 且 USER 不是 root 时创建自定义用户。
# PUID=0
# PGID=0
# USER=root
# WORKDIR=/root

# Debian 变体
# DEBIAN_FRONTEND=noninteractive

# frps 业务配置位于挂载的 frps.toml，不在此重复定义。
