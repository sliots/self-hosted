# 来源：https://github.com/SnowLuma/SnowLuma.Docker.Framework；https://github.com/SnowLuma/SnowLuma
# Docker Compose 环境变量示例

# Compose 必填配置
# VNC 会通过 5900/noVNC 暴露桌面；请使用随机强密码，不要提交真实值。
VNC_PASSWD=

# Compose 可选配置
# 上游同时发布版本标签和 latest；默认沿用 latest，稳定部署可固定到明确版本。
# SNOWLUMA_IMAGE=motricseven7/snowluma:latest
# SNOWLUMA_CONTAINER=snowluma
# BIND_ADDRESS=0.0.0.0
# VNC_PORT=5900
# NOVNC_PORT=6081
# SNOWLUMA_WEBUI_HOST_PORT=5099
# OneBot 的实际监听端口由 WebUI 配置；修改后需同步调整以下宿主端口映射。
# ONEBOT_HTTP_PORT=3000
# ONEBOT_WS_PORT=3001
# SNOWLUMA_WATCHTOWER_ENABLE=true

# 容器用户与时区
# 应与持久卷宿主目录的属主一致；上游镜像默认 1000:1000。
# SNOWLUMA_UID=1000
# SNOWLUMA_GID=1000
# 镜像默认 Asia/Shanghai；仅在确有需要时覆盖。
# TZ=Asia/Shanghai

# WebUI
# 容器发布 WebUI 端口时必须监听全部容器接口；当前 Compose 显式固定此默认值。
# SNOWLUMA_WEBUI_HOST=0.0.0.0
# 有效范围 1-65535；修改后 Compose 会同步容器目标端口和宿主映射。
# SNOWLUMA_WEBUI_PORT=5099
# 初次启动时为 admin 写入指定密码，至少 8 个字符；已存在凭据时不会覆盖。
# 留空时自动生成临时密码，并仅在全新数据卷首次启动时输出到日志。
# SNOWLUMA_WEBUI_BOOTSTRAP_PASSWORD=
# 反向代理信任模式：空值表示不信任代理头；可选值为 loopback、1、true、all，
# 或英文逗号分隔的代理 IP。1/true/all 仅适用于会清理客户端伪造头的可信代理。
# SNOWLUMA_WEBUI_TRUST_PROXY=

# 桌面与 QQ
# 格式：宽x高x色深。上游当前默认色深为 24，旧的 16 已不再是 Compose 默认值。
# SNOWLUMA_SCREEN=1920x1080x24
# 可选值：1、true、yes、on 或 0、false、no、off。
# SNOWLUMA_HOOK_AUTOLOAD=1
# 设为 1 时跳过 Linux QQ 进程筛选并尝试对所有枚举到的进程自动注入；通常不要启用。
# SNOWLUMA_HOOK_AUTOLOAD_ALL=0
# 额外 QQ HOME，使用英文逗号或空格分隔，路径必须位于 /app 下。
# 每个路径还必须在 Compose 中配置独立持久卷，不能与其他 QQ 实例共用 HOME。
# SNOWLUMA_EXTRA_QQ_HOMES=
# 默认关闭 GPU 和 SwiftShader，以避免无硬件 GPU 时的长期内存增长。
# 当前入口脚本会把空值重新替换为默认参数，不能靠空字符串清除；
# GPU 直通场景需要填写非空的自定义 QQ 参数并实际验证硬件加速状态。
# SNOWLUMA_QQ_FLAGS=--disable-gpu --disable-software-rasterizer --disable-gpu-compositing

# 日志
# 控制台可选值：trace、debug、info、success、warn、error。
# SNOWLUMA_LOG_LEVEL=info
# 文件日志可选值：debug、info、success、warn、error；trace 永远不会写入磁盘。
# SNOWLUMA_LOG_FILE_LEVEL=debug
# 仅值 0 会关闭文件日志，其他值或未设置都会启用。
# SNOWLUMA_LOG_FILE=1
# 相对路径基于 /app/data；默认目录已由 snowluma-data 卷持久化。
# SNOWLUMA_LOG_DIR=logs
# 单个日志文件大小上限，单位 MiB，必须为正整数。
# SNOWLUMA_LOG_MAX_MB=50
# 所有受管日志的总大小上限，单位 MiB，必须为正整数。
# SNOWLUMA_LOG_MAX_TOTAL_MB=1024
# 日历日保留天数，0 表示不按日期删除。
# SNOWLUMA_LOG_RETAIN_DAYS=7
# 是否额外写入 logs/<QQ号>/ 账号专属日志。
# 可选值：1、true、yes、on 或 0、false、no、off。
# SNOWLUMA_LOG_PER_UIN=0
# trace 内存环形缓冲区条目数，最小值 100。
# SNOWLUMA_TRACE_BUFFER=5000
# 设为 1 时关闭 ANSI 彩色日志。
# NO_COLOR=0
# 设为 1 时输出好友、群和成员预热的详细日志。
# SNOWLUMA_VERBOSE_WARMUP=0

# 更新检查与无人值守协议确认
# 默认启用；设为 0、false、off 或 no 可关闭 GitHub 更新检查。
# SNOWLUMA_UPDATE_CHECK=true
# 仅在部署者已经阅读并接受镜像内对应版本协议时设置为 1 或 true。
# 两项必须同时接受；删除变量会恢复 WebUI 的版本化确认流程。
# SNOWLUMA_ACCEPT_EULA=false
# SNOWLUMA_ACCEPT_PRIVACY=false

# 高级内部路径
# 以下值由镜像入口脚本管理，通常不要覆盖。修改数据目录时必须同步调整卷挂载。
# SNOWLUMA_HOME=/app/runtime
# SNOWLUMA_DATA=/app/data
# DISPLAY=:1
# XDG_RUNTIME_DIR=/tmp/runtime-1000
# SNOWLUMA_HOOK_RUNTIME_DIR=/tmp/runtime-1000

# 权限边界
# SnowLuma native hook 需要 SYS_PTRACE 和 seccomp=unconfined；当前 Compose 按上游要求保留。
# 上游镜像已为 Node.js 设置 cap_sys_ptrace，不需要 privileged: true，也通常不需要修改
# 宿主机 kernel.yama.ptrace_scope。不要删除 VNC 密码或直接公开未受保护的管理端口。
