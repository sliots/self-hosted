# 来源：https://github.com/tt-rss/tt-rss；https://tt-rss.org/docs/Installation-Guide.html

# 必填变量
# PostgreSQL 密码。不要提交真实值。
TTRSS_DB_PASS=
# Tiny Tiny RSS 的完整外部 URL，默认子路径部署示例：https://rss.example.com/tt-rss
TTRSS_SELF_URL_PATH=

# Compose 与镜像版本
# TT_RSS_IMAGE_TAG=latest
# TT_RSS_WEB_NGINX_IMAGE_TAG=latest
# POSTGRES_IMAGE_TAG=18
# BIND_ADDRESS=0.0.0.0
# TT_RSS_HOST_PORT=8280
# 旧版 HTTP_PORT 已拆分为仅控制宿主映射的 TT_RSS_HOST_PORT，不再传入应用容器。
# MNT_DIR=/mnt/docker
# 生产布局会把 ${MNT_DIR}/ttrss/app 挂载到 /var/www/html，源码位于宿主 app/tt-rss 子目录。

# 可选容器名称
# APP_CONTAINER_NAME=app
# WEB_NGINX_CONTAINER_NAME=web-nginx
# UPDATER_CONTAINER_NAME=updater
# DB_CONTAINER_NAME=db

# Watchtower 更新策略
# APP_WATCHTOWER_ENABLE=true
# WEB_NGINX_WATCHTOWER_ENABLE=true
# UPDATER_WATCHTOWER_ENABLE=true
# DB_WATCHTOWER_ENABLE=false

# 数据库连接
# PostgreSQL 是当前唯一支持的数据库；TTRSS_DB_TYPE 仅为兼容旧配置保留。
# TTRSS_DB_TYPE=pgsql
# TTRSS_DB_HOST=db
# TTRSS_DB_USER=postgres
# TTRSS_DB_NAME=postgres
# TTRSS_DB_PORT=5432
# SSL 模式可选：prefer、require、disable。
# TTRSS_DB_SSLMODE=prefer

# URL、登录与会话
# 仅在 CLI 无法从请求推断 URL 时使用 SELF_URL；设为 true 可强制所有场景使用它。
# TTRSS_FORCE_SELF_URL_PATH_USAGE=false
# TTRSS_SINGLE_USER_MODE=false
# TTRSS_AUTH_AUTO_CREATE=true
# TTRSS_AUTH_AUTO_LOGIN=true
# TTRSS_SESSION_COOKIE_LIFETIME=86400
# TTRSS_SESSION_NAME=ttrss_sid
# TTRSS_AUTH_MIN_INTERVAL=5
# TTRSS_DISABLE_LOGIN_FORM=false
# TTRSS_FORBID_PASSWORD_CHANGES=false

# 内置管理员
# 未设置 ADMIN_USER_PASS 时，首次启动会生成随机密码并输出到 app 容器日志。
# ADMIN_USER_PASS=
# 权限级别：-2 禁止登录，-1 只读，0 普通用户，10 管理员。
# ADMIN_USER_ACCESS_LEVEL=

# 自动创建附加用户
# 仅在 AUTO_CREATE_USER 非空且用户不存在时创建。
# AUTO_CREATE_USER=
# AUTO_CREATE_USER_PASS=
# AUTO_CREATE_USER_ACCESS_LEVEL=0
# AUTO_CREATE_USER_ENABLE_API=

# 应用目录与 PHP-FPM
# APP_INSTALL_BASE_DIR=/var/www/html
# OWNER_UID=1000
# OWNER_GID=1000
# PHP_WORKER_MAX_CHILDREN=5
# PHP_WORKER_MEMORY_LIMIT=256M
# TTRSS_PHP_EXECUTABLE=/usr/bin/php85
# TTRSS_LOCK_DIRECTORY=lock
# TTRSS_CACHE_DIR=cache
# TTRSS_LOCAL_PLUGINS_DIR=plugins.local
# TTRSS_LOCAL_TEMPLATES_DIR=templates.local
# TTRSS_LOCAL_THEMES_DIR=themes.local

# 插件、主题与更新
# 镜像默认额外启用 note 和 nginx_xaccel；覆盖时需保留需要的插件。
# TTRSS_PLUGINS=auth_internal, note, nginx_xaccel
# TTRSS_CHECK_FOR_UPDATES=true
# TTRSS_CHECK_FOR_PLUGIN_UPDATES=true
# TTRSS_ENABLE_PLUGIN_INSTALLER=true
# 以下三个开关由 shell 按“非空即启用”判断；禁用时必须保持未设置或空值。
# TTRSS_NO_STARTUP_PLUGIN_UPDATES=
# SKIP_LEGACY_ORIGIN_REPLACE=
# 生产镜像更新依赖启动时 rsync，通常不要启用 SKIP_RSYNC_ON_STARTUP。
# SKIP_RSYNC_ON_STARTUP=
# TTRSS_DEFAULT_LIGHT_THEME=light.css
# TTRSS_DEFAULT_DARK_THEME=night.css
# TTRSS_LOCAL_OVERRIDE_STYLESHEET=local-overrides.css
# TTRSS_LOCAL_OVERRIDE_JS=local-overrides.js

# 内容清理、缓存与下载限制
# TTRSS_FORCE_ARTICLE_PURGE=0
# TTRSS_MAX_CACHE_FILE_SIZE=67108864
# TTRSS_MAX_DOWNLOAD_FILE_SIZE=16777216
# TTRSS_MAX_FAVICON_FILE_SIZE=1048576
# TTRSS_CACHE_MAX_DAYS=7
# TTRSS_MAX_CONDITIONAL_INTERVAL=43200
# TTRSS_DAEMON_UNSUCCESSFUL_DAYS_LIMIT=30

# 抓取与更新守护进程
# TTRSS_DAEMON_MAX_CHILD_RUNTIME=1800
# TTRSS_DAEMON_MAX_JOBS=2
# 日志级别：-1 禁用，0 普通，1 详细，2 扩展。
# TTRSS_DAEMON_LOG_LEVEL=0
# TTRSS_FEED_FETCH_TIMEOUT=45
# TTRSS_FEED_FETCH_NO_CACHE_TIMEOUT=15
# TTRSS_FILE_FETCH_TIMEOUT=45
# TTRSS_FILE_FETCH_CONNECT_TIMEOUT=15
# TTRSS_DAEMON_UPDATE_LOGIN_LIMIT=30
# TTRSS_DAEMON_FEED_LIMIT=50
# TTRSS_DAEMON_SLEEP_INTERVAL=120
# TTRSS_HTTP_429_THROTTLE_INTERVAL=3600
# TTRSS_HTTP_USER_AGENT="Tiny Tiny RSS/%s (https://github.com/tt-rss/tt-rss)"

# 日志与邮件
# 日志目标可选：sql、syslog、stdout。
# TTRSS_LOG_DESTINATION=sql
# TTRSS_LOG_SENT_MAIL=false
# TTRSS_SMTP_FROM_NAME="Tiny Tiny RSS"
# TTRSS_SMTP_FROM_ADDRESS=noreply@localhost
# TTRSS_DIGEST_SUBJECT="[tt-rss] New headlines for last 24 hours"

# 内置任务计划；值为 cron 表达式，留空可禁用对应任务。
# TTRSS_SCHEDULE_PURGE_ORPHANS=@daily
# TTRSS_SCHEDULE_DISK_CACHE_EXPIRE_ALL=@daily
# TTRSS_SCHEDULE_DISABLE_FAILED_FEEDS=@daily
# TTRSS_SCHEDULE_CLEANUP_FEED_ICONS=@daily
# TTRSS_SCHEDULE_LOG_DAEMON_UPDATE_LOGIN_LIMIT_USERS=@daily
# TTRSS_SCHEDULE_EXPIRE_ERROR_LOG=@hourly
# TTRSS_SCHEDULE_EXPIRE_LOCK_FILES=@hourly
# TTRSS_SCHEDULE_SEND_HEADLINES_DIGESTS=@hourly

# 加密
# 32 字节十六进制密钥，可在容器内运行 update.php --gen-encryption-key 生成。
# TTRSS_ENCRYPTION_KEY=

# 调试
# TTRSS_XDEBUG_ENABLED=
# 未设置主机时，镜像会尝试使用默认网关地址。
# TTRSS_XDEBUG_HOST=
# TTRSS_XDEBUG_PORT=9000

# tt-rss 应用层代理
# TTRSS_HTTP_PROXY=

# 镜像进行 Git、插件更新时继承的标准代理变量
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
# ALL_PROXY=
# http_proxy=
# https_proxy=
# no_proxy=
# all_proxy=

# Web Nginx
# 默认在 /tt-rss 提供服务；若要部署在根路径，同时设置 APP_WEB_ROOT=/var/www/html/tt-rss 和 APP_BASE=。
# APP_UPSTREAM=app
# APP_FASTCGI_PASS='$backend'
# APP_WEB_ROOT=/var/www/html
# APP_BASE=/tt-rss
# RESOLVER=127.0.0.11

# PostgreSQL 官方镜像高级选项
# POSTGRES_INITDB_ARGS=
# POSTGRES_INITDB_WALDIR=
# POSTGRES_HOST_AUTH_METHOD=
# PGDATA=

# Secret 文件覆盖
# app/updater 支持任意 VARIABLE__FILE，文件内容会覆盖同名 VARIABLE；这不是标准 *_FILE 命名。
# TTRSS_DB_PASS__FILE=/run/secrets/ttrss_db_pass
# ADMIN_USER_PASS__FILE=/run/secrets/admin_user_pass

# tt-rss 应用配置中的布尔值统一使用小写 true/false；源码仅把空值、0、f、false 识别为 false。
# 镜像启动脚本中的存在性开关则是非空即启用，不能用字符串 false 表示关闭。
