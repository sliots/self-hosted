# 来源：https://docs.docker.com/guides/postgresql/；https://hub.docker.com/_/postgres

# Compose 必填配置
# PostgreSQL 超级用户密码；请使用随机强密码，不要提交真实值。
POSTGRES_PASSWORD=

# Compose 可选配置
# POSTGRES_IMAGE_TAG=18.6
# POSTGRES_CONTAINER_NAME=postgres
# BIND_ADDRESS=0.0.0.0
# PORT=5432
# MNT_DIR=/mnt/docker
# TMP_DIR=/tmp
# INITDB_DIR=/mnt/docker/postgres-initdb
# SHM_SIZE=256M
# RESOURCES_LIMITS_MEMORY=1G
# 数据库默认不由 Watchtower 自动更新，主版本升级必须执行迁移流程。
# WATCHTOWER_ENABLE=false

# 数据目录版本边界
# PostgreSQL 18+ 默认 PGDATA 为 /var/lib/postgresql/<major>/docker，当前卷应挂载父目录。
# PostgreSQL 17 及以下必须把卷直接挂载到 /var/lib/postgresql/data；不能只修改镜像 tag。
# PGDATA=/var/lib/postgresql/18/docker
# 修改容器内部端口时必须同步调整 Compose 端口映射和健康检查。
# PGPORT=5432

# 首次初始化
# 以下 POSTGRES_* 初始化变量只在数据目录为空时生效，已有数据库不会被重新配置。
# POSTGRES_USER=postgres
# 未设置时使用 POSTGRES_USER 的值。
# POSTGRES_DB=postgres
# 传递给 initdb 的参数，例如 --data-checksums。
# POSTGRES_INITDB_ARGS=--data-checksums
# 将 WAL 放在数据父目录内的独立子目录；如改为其他路径，必须增加对应持久化挂载。
# POSTGRES_INITDB_WALDIR=/var/lib/postgresql/wal

# 主机认证
# PostgreSQL 14+ 默认使用 scram-sha-256。
# 常见值：scram-sha-256、md5、password、cert、reject、trust。
# trust 会允许无密码连接，即使设置了 POSTGRES_PASSWORD，也不应在普通部署中使用。
# POSTGRES_HOST_AUTH_METHOD=scram-sha-256

# Docker secrets 文件变量
# 当前 Compose 未挂载 secrets；启用前需自行增加只读文件或 secrets 挂载。
# 同名普通变量与 *_FILE 变量不能同时设置。
# POSTGRES_PASSWORD_FILE=
# POSTGRES_USER_FILE=
# POSTGRES_DB_FILE=
# POSTGRES_INITDB_ARGS_FILE=

# 初始化脚本
# INITDB_DIR 中可放置 *.sql、*.sql.gz 和 *.sh 文件。
# 脚本只在首次初始化空数据目录时按文件名顺序执行。
