# 来源：https://komo.do/docs/setup/advanced；https://komo.do/docs/setup/connect-servers
# Compose 配置
# COMPOSE_KOMODO_IMAGE_TAG=2.13.4
# CONTAINER_NAME=komodo-periphery
# WATCHTOWER_ENABLE=true

# 连接模式一：Core 主动连接 Periphery
# 取消 Compose 中 ports 块的注释，再设置下列宿主绑定参数。
# BIND_ADDRESS=0.0.0.0
# PORT=8120
# 建议限制为 Core 服务器 IP 或网段，使用逗号分隔。
# PERIPHERY_ALLOWED_IPS=

# 连接模式二：Periphery 主动连接 Core
# 同机分离 Compose 部署可使用 host.docker.internal；跨机使用 ws:// 或 wss:// Core 地址。
# PERIPHERY_CORE_ADDRESS=ws://host.docker.internal:9120
# 必须与 Core UI 中已有或将创建的 Server 名称一致。
# PERIPHERY_CONNECT_AS=
# 仅首次自动创建 Server 时需要，成功 onboarding 后可删除。
# PERIPHERY_ONBOARDING_KEY=

# 目录
# 根目录在宿主机和容器中必须使用相同绝对路径。
# PERIPHERY_ROOT_DIRECTORY=/etc/komodo
# 相对路径会基于 PERIPHERY_ROOT_DIRECTORY 解析。
# PERIPHERY_STACK_DIR=stacks
# PERIPHERY_REPO_DIR=repos

# 身份密钥
# 默认持久化到 Compose 的 keys 命名卷。
# PERIPHERY_PRIVATE_KEY=file:/config/keys/periphery.key
# 首次连接 Core 后可自动写入该文件。
# PERIPHERY_CORE_PUBLIC_KEYS=file:/config/keys/core.pub
# v1 兼容项，新部署不建议使用。
# PERIPHERY_PASSKEYS=

# 入站服务与 TLS
# PERIPHERY_PORT=8120
# PERIPHERY_BIND_IP=0.0.0.0
# PERIPHERY_SSL_ENABLED=true
# 相对路径会基于 PERIPHERY_ROOT_DIRECTORY 解析。
# PERIPHERY_SSL_KEY_FILE=ssl/key.pem
# PERIPHERY_SSL_CERT_FILE=ssl/cert.pem

# 远程操作权限
# 禁用后将无法通过 Komodo 打开 Periphery 容器内的终端。
# PERIPHERY_DISABLE_TERMINALS=false
# 禁用后将无法对其他容器执行 shell。
# PERIPHERY_DISABLE_CONTAINER_EXEC=false

# 磁盘统计过滤
# 两者选其一，使用逗号分隔的挂载路径。
# 单根磁盘主机通常可只包含 /etc/hostname。
# PERIPHERY_INCLUDE_DISK_MOUNTS=/etc/hostname
# PERIPHERY_EXCLUDE_DISK_MOUNTS=

# 日志
# PERIPHERY_LOGGING_LEVEL 可选值：off、error、warn、info、debug、trace。
# PERIPHERY_LOGGING_LEVEL=info
# PERIPHERY_LOGGING_STDIO 可选值：none、standard、json。
# PERIPHERY_LOGGING_STDIO=standard
# PERIPHERY_LOGGING_PRETTY=false
# PERIPHERY_LOGGING_OPENTELEMETRY_SERVICE_NAME=Komodo
# PERIPHERY_LOGGING_OTLP_ENDPOINT=
# PERIPHERY_LOGGING_LOKI_URL=
# PERIPHERY_LOGGING_LOKI_LABEL=komodo

# 上游还支持 PERIPHERY_PRIVATE_KEY_FILE 和 PERIPHERY_PASSKEYS_FILE。
# 本仓库当前不挂载 Compose secrets，因此不提供 *_FILE 赋值。
