# 来源：https://watchtower.nickfedor.com/v1.21.2/；https://github.com/nicholas-fedor/watchtower/tree/v1.21.2

# Compose 参数
# IMAGE_TAG=latest
# CONTAINER_NAME=watchtower
# WATCHTOWER_ENABLE=true
# 仅在启用 HTTP API 并取消 Compose 中的 ports 注释时使用。
# BIND_ADDRESS=127.0.0.1
# WATCHTOWER_HTTP_API_HOST_PORT=8080

# 当前 Compose 策略
# 这些值覆盖上游默认值；取消注释后可调整。
# WATCHTOWER_CLEANUP=true
# WATCHTOWER_LABEL_ENABLE=true
# WATCHTOWER_POLL_INTERVAL=600
# WATCHTOWER_UPDATE_ON_START=true

# 时区
# cron 调度按此时区解释；镜像默认 UTC。
# TZ=UTC

# Docker 连接
# 本地 socket 是默认连接；改用远程 daemon 时可移除 Compose 中的 socket 挂载。
# DOCKER_HOST=unix:///var/run/docker.sock
# DOCKER_TLS_VERIFY=false
# DOCKER_API_VERSION=
# DOCKER_CERT_PATH=
# 私有仓库认证文件 config.json 所在目录，镜像默认根目录 /。
# DOCKER_CONFIG=/

# 容器选择
# true 时只处理 com.centurylinklabs.watchtower.enable=true 的容器。
## 当前 Compose 默认启用 WATCHTOWER_LABEL_ENABLE。
# 以下容器名和镜像名列表支持逗号或空格分隔。
# WATCHTOWER_DISABLE_CONTAINERS=
# WATCHTOWER_MONITOR_IMAGE_NAMES=
# WATCHTOWER_SKIP_IMAGE_NAMES=
# label 过滤器使用逗号分隔的 key=value 项。
# WATCHTOWER_ENABLE_CONTAINERS_BY_LABEL=
# WATCHTOWER_DISABLE_CONTAINERS_BY_LABEL=
# 多 Watchtower 实例可使用相同 scope 隔离管理范围。
# WATCHTOWER_SCOPE=

# 容器状态与重建
# WATCHTOWER_INCLUDE_STOPPED=false
# WATCHTOWER_INCLUDE_RESTARTING=false
# 只有同时启用 INCLUDE_STOPPED 时，REVIVE_STOPPED 才生效。
# WATCHTOWER_REVIVE_STOPPED=false
# 删除的是匿名卷；持久化数据卷通常不应启用。
# WATCHTOWER_REMOVE_VOLUMES=false
# HEAD 失败告警可选：always、auto、never。
# WATCHTOWER_WARN_ON_HEAD_FAILURE=auto
# Podman 兼容选项。
# WATCHTOWER_DISABLE_MEMORY_SWAPPINESS=false
# CPU 复制模式可选：auto、full、none。
# WATCHTOWER_CPU_COPY_MODE=auto

# 调度与运行模式
# 上游轮询默认 86400 秒；设置 WATCHTOWER_SCHEDULE 后不要同时依赖轮询间隔。
## 当前 Compose 默认轮询间隔为 600 秒。
# 6 字段 cron 表达式，第一字段为秒，例如每天 04:00：0 0 4 * * *
# WATCHTOWER_SCHEDULE=
## 当前 Compose 默认在启动时检查更新。
# 运行一次后退出。
# WATCHTOWER_RUN_ONCE=false
# 程序化输出可选：v1、json。
# WATCHTOWER_PORCELAIN=
# WATCHTOWER_NO_STARTUP_MESSAGE=false

# 更新行为
## 当前 Compose 默认清理更新后不再使用的旧镜像。
# WATCHTOWER_NO_PULL=false
# WATCHTOWER_NO_RESTART=false
# 仅检测更新而不重建容器。
# WATCHTOWER_MONITOR_ONLY=false
# WATCHTOWER_ROLLING_RESTART=false
# 停止超时支持 Go duration；裸数字为兼容旧配置按秒解释。
# WATCHTOWER_TIMEOUT=30s
# 镜像冷却时间支持 s、m、h、d、w、M，例如 3d 或 1w12h；留空禁用。
# WATCHTOWER_COOLDOWN_DELAY=
# 通常自动使用运行平台，仅跨平台检查时覆盖。
# WATCHTOWER_COOLDOWN_PLATFORM_OS=
# WATCHTOWER_COOLDOWN_PLATFORM_ARCH=
# WATCHTOWER_COOLDOWN_PLATFORM_VARIANT=
# WATCHTOWER_USE_COMPOSE_DEPENDS_ON=true
# 允许容器 label 覆盖全局更新参数。
# WATCHTOWER_LABEL_TAKE_PRECEDENCE=false
# 实验性临时容器自更新编排。
# WATCHTOWER_EPHEMERAL_SELF_UPDATE=false

# 生命周期钩子
# WATCHTOWER_LIFECYCLE_HOOKS=false
# 默认以 root 身份执行；可由容器 label 覆盖。
# WATCHTOWER_LIFECYCLE_UID=0
# WATCHTOWER_LIFECYCLE_GID=0

# 私有仓库与 TLS
# REPO_USER=
# REPO_PASS=
# 跳过验证会降低安全性，仅用于明确受控的私有仓库。
# WATCHTOWER_REGISTRY_TLS_SKIP=false
# 可选：TLS1.0、TLS1.1、TLS1.2、TLS1.3。
# WATCHTOWER_REGISTRY_TLS_MIN_VERSION=TLS1.2

# 标准代理变量；大小写形式均受支持。
# HTTP_PROXY=
# HTTPS_PROXY=
# NO_PROXY=
# http_proxy=
# https_proxy=
# no_proxy=

# 日志
# 格式可选：auto、logfmt、pretty、json。
# WATCHTOWER_LOG_FORMAT=auto
# 级别可选：panic、fatal、error、warn、info、debug、trace。
# WATCHTOWER_LOG_LEVEL=info
# WATCHTOWER_DEBUG=false
# trace 可能输出凭据，仅限短时故障排查。
# WATCHTOWER_TRACE=false
# NO_COLOR 按变量是否存在判断；任意已设置值都会禁用 ANSI 颜色。
# NO_COLOR=1

# HTTP API
# 端点可选：health、update、metrics、containers、check、history、images、config、events、swagger 或 all。
# 留空禁用 HTTP API；非 health 端点必须配置 WATCHTOWER_HTTP_API_TOKEN。
# WATCHTOWER_HTTP_API_ENDPOINTS=
# 空 host 表示监听所有接口；外部访问时建议配合反向代理和访问控制。
# WATCHTOWER_HTTP_API_HOST=
# WATCHTOWER_HTTP_API_PORT=8080
# 可直接填写密钥，也可填写容器内只读密钥文件路径。
# WATCHTOWER_HTTP_API_TOKEN=
# events SSE 端点使用独立令牌。
# WATCHTOWER_HTTP_API_EVENTS_TOKEN=
# WATCHTOWER_HTTP_API_PERIODIC_POLLS=false
# 每 IP 每分钟允许的认证请求数。
# WATCHTOWER_HTTP_API_RATE_LIMIT=60
# 同时设置证书和私钥才启用 TLS；需额外挂载相应文件。
# WATCHTOWER_HTTP_API_TLS_CERT=
# WATCHTOWER_HTTP_API_TLS_KEY=
# 可信代理支持逗号或空格分隔的 IP/CIDR。
# WATCHTOWER_HTTP_API_TRUSTED_PROXIES=
# WATCHTOWER_HTTP_API_PROXY_HEADER=X-Forwarded-For
# 允许的 CORS origin 列表；留空仅允许同源。
# WATCHTOWER_HTTP_API_CORS_ORIGINS=
# WATCHTOWER_HTTP_API_CHECK_TIMEOUT=5m
# WATCHTOWER_HTTP_API_UPDATE_TIMEOUT=10m

# 已弃用 HTTP API 开关；改用 WATCHTOWER_HTTP_API_ENDPOINTS。
# WATCHTOWER_HTTP_API_UPDATE=false
# WATCHTOWER_HTTP_API_METRICS=false
# WATCHTOWER_HTTP_API_CONTAINERS=false

# Shoutrrr 通知
# 支持逗号或空格分隔多个 URL，也可填写包含每行一个 URL 的密钥文件路径。
# WATCHTOWER_NOTIFICATION_URL=
# 通知级别可选：panic、fatal、error、warn、info、debug。
# WATCHTOWER_NOTIFICATIONS_LEVEL=info
# WATCHTOWER_NOTIFICATIONS_DELAY=0
# WATCHTOWER_NOTIFICATIONS_HOSTNAME=
# WATCHTOWER_NOTIFICATION_TEMPLATE=
# 文件模板优先于内联模板；需额外挂载文件。
# WATCHTOWER_NOTIFICATION_TEMPLATE_FILE=
# WATCHTOWER_NOTIFICATION_REPORT=false
# WATCHTOWER_NOTIFICATION_TITLE_TAG=
# WATCHTOWER_NOTIFICATION_SKIP_TITLE=false
# WATCHTOWER_NOTIFICATION_LOG_STDOUT=false
# WATCHTOWER_NOTIFICATION_SPLIT_BY_CONTAINER=false

# Docker Secret / 文件值示例
# 下列变量原生支持把值设置为容器内文件路径，而不是使用额外的 _FILE 后缀。
## WATCHTOWER_HTTP_API_TOKEN 文件示例：/run/secrets/watchtower_api_token
## WATCHTOWER_HTTP_API_EVENTS_TOKEN 文件示例：/run/secrets/watchtower_events_token
## WATCHTOWER_NOTIFICATION_URL 文件示例：/run/secrets/watchtower_notification_urls

# v2 将移除的旧通知配置；新部署应使用 WATCHTOWER_NOTIFICATION_URL。
# WATCHTOWER_NOTIFICATIONS=
# WATCHTOWER_NOTIFICATION_EMAIL_FROM=
# WATCHTOWER_NOTIFICATION_EMAIL_TO=
# WATCHTOWER_NOTIFICATION_EMAIL_DELAY=0
# WATCHTOWER_NOTIFICATION_EMAIL_SERVER=
# WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PORT=25
# WATCHTOWER_NOTIFICATION_EMAIL_SERVER_TLS_SKIP_VERIFY=false
# WATCHTOWER_NOTIFICATION_EMAIL_SERVER_USER=
# WATCHTOWER_NOTIFICATION_EMAIL_SERVER_PASSWORD=
# WATCHTOWER_NOTIFICATION_EMAIL_SUBJECTTAG=
# WATCHTOWER_NOTIFICATION_SLACK_HOOK_URL=
# WATCHTOWER_NOTIFICATION_SLACK_IDENTIFIER=watchtower
# WATCHTOWER_NOTIFICATION_SLACK_CHANNEL=
# WATCHTOWER_NOTIFICATION_SLACK_ICON_EMOJI=
# WATCHTOWER_NOTIFICATION_SLACK_ICON_URL=
# WATCHTOWER_NOTIFICATION_MSTEAMS_HOOK_URL=
# WATCHTOWER_NOTIFICATION_GOTIFY_URL=
# WATCHTOWER_NOTIFICATION_GOTIFY_TOKEN=
# WATCHTOWER_NOTIFICATION_GOTIFY_TLS_SKIP_VERIFY=false

# 敏感值保持为空，不要提交真实仓库密码、API token、Webhook 或通知 URL。
