# 来源：https://beszel.dev/zh/guide/what-is-beszel
# Compose 配置
# IMAGE_TAG=0
# CONTAINER_NAME=beszel
# BIND_ADDRESS=0.0.0.0
# PORT=8090
# MNT_DIR=/mnt/docker
# WATCHTOWER_ENABLE=true

# Hub 基础配置
# 所有 Hub 变量也可以使用 BESZEL_HUB_ 前缀。
APP_URL=http://localhost:8090
# AUTO_LOGIN=
# CHECK_UPDATES=false
# CONTAINER_DETAILS=true
# CSP=
# DISABLE_PASSWORD_AUTH=false
# MFA_OTP=false
# OAUTH_DISABLE_POPUP=false
# SHARE_ALL_SYSTEMS=false
# TRUSTED_AUTH_HEADER=
# USER_CREATION=false

# 首次启动时创建管理员；密码必须自行设置，不要提交真实值。
# USER_EMAIL=
# USER_PASSWORD=

# 外部心跳监控；HEARTBEAT_URL 为空时禁用。
# HEARTBEAT_URL=
# HEARTBEAT_INTERVAL=60
# HEARTBEAT_METHOD=POST
