# 来源：https://hub.docker.com/_/redis
# Docker Compose 环境变量示例

# 必填密码
# 使用随机强密码，不要提交真实值。Redis Official Image 不会自动读取 REDIS_PASSWORD；
# 当前 Compose 将本变量转换为 redis-server 的 requirepass 参数。
REDIS_PASSWORD=

# Compose 可选配置
# 截至 2026-08-26，Redis Official Image 的 latest 对应 7.4.8；此处固定补丁版本。
# 可根据需要使用 7.4.8-bookworm、7.4.8-alpine 等官方变体。
# REDIS_IMAGE_TAG=7.4.8
# REDIS_CONTAINER_NAME=redis
# 保留原部署的 Docker bridge 地址，避免默认向所有宿主机接口公开。
# rootless Docker 或自定义网桥没有 172.17.0.1 时需改为实际地址。
# BIND_ADDRESS=172.17.0.1
# REDIS_PORT=6379
# 缓存服务允许由 Watchtower 更新；用于关键状态存储时应改为 false。
# REDIS_WATCHTOWER_ENABLE=true

# 安全
# 可选值：yes、no。即使设置了密码，也建议保持 yes。
# REDIS_PROTECTED_MODE=yes

# 持久化
# 当前部署定位为可丢失缓存，RDB 和 AOF 默认均关闭，因此不挂载 /data。
# RDB save 规则格式为“秒数 写入次数”，例如 60 1；空值表示关闭快照。
# REDIS_SAVE=
# 可选值：yes、no。
# REDIS_APPENDONLY=no
# 仅 REDIS_APPENDONLY=yes 时生效；可选值：always、everysec、no。
# REDIS_APPENDFSYNC=everysec
# 如果需要持久化，应启用 RDB 或 AOF，并为 /data 增加命名卷或 bind mount。

# 内存与淘汰
# 0 表示不设置 Redis 自身内存上限；生产缓存建议结合容器限制设置明确值，例如 512mb。
# REDIS_MAXMEMORY=0
# 可选值：noeviction、allkeys-lru、allkeys-lfu、allkeys-random、volatile-lru、
# volatile-lfu、volatile-random、volatile-ttl。
# REDIS_MAXMEMORY_POLICY=noeviction

# 连接与数据库
# 逻辑数据库数量；集群模式仅支持数据库 0。
# REDIS_DATABASES=16
# 空闲客户端超时，单位秒；0 表示不主动断开。
# REDIS_TIMEOUT=0
# TCP keepalive 间隔，单位秒；0 表示关闭。
# REDIS_TCP_KEEPALIVE=300

# 日志
# 可选值：debug、verbose、notice、warning、nothing。
# REDIS_LOGLEVEL=notice

# 高级配置
# Redis Official Image 不会把任意 REDIS_* 环境变量自动转换为服务端配置。
# ACL、TLS、复制、Sentinel、集群、慢日志和细粒度持久化设置应写入 redis.conf，
# 挂载到 /usr/local/etc/redis/redis.conf，并把 command 改为：
# redis-server /usr/local/etc/redis/redis.conf
# 官方镜像的 protected mode 默认关闭；不要在无密码时发布 6379 端口。
