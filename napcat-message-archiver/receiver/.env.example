# Docker Compose 环境变量示例

# 必填变量
NAPCAT_AUTH_TOKEN=
POSTGRES_PASSWORD=
WS_AUTH_TOKEN=

# 无默认值，按部署需要填写
NAPCAT_API_URL=
WS_URL=

# 可选变量及当前安全默认值
# CONTAINER_NAME=napcat-message-archiver-receiver
# DATA_DIR=/mnt/docker/napcat-message-archiver-receiver
# DB_DIRECT_ENABLED=auto
# HOSTNAME=napcat-message-archiver-receiver
# IMAGE_TAG=latest
# POSTGRES_DB=postgres
# POSTGRES_HOST=172.17.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# RECEIVER_FEISHU_WEBHOOK_URL=
# RECEIVER_NAME=
# RECONNECT_DELAY=5
# RELAY_AUTH_TOKEN=
# RELAY_URL=
# TZ=Asia/Shanghai
# WATCHTOWER_ENABLE=true
