# HOSTNAME=napcat-message-archiver-relay
# IMAGE_TAG=latest
# POSTGRES_DB=postgres
# POSTGRES_HOST=172.17.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# RELAY_AUTH_TOKEN=
# TZ=Asia/Shanghai
# WATCHTOWER_ENABLE=true
