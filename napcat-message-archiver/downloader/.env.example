# Docker Compose 环境变量示例

# 必填变量
POSTGRES_PASSWORD=

# 可选变量及当前安全默认值
# CONTAINER_NAME=napcat-message-archiver-downloader
# DOWNLOADER_BATCH_SIZE=20
# DOWNLOADER_DOWNLOAD_TIMEOUT=60
# DOWNLOADER_IMAGE_BASE_DIR=/data/images
# DOWNLOADER_MAX_RETRIES=3
# DOWNLOADER_POLL_INTERVAL=10
