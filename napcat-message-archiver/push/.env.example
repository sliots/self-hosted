# Docker Compose 环境变量示例

# 必填变量
POSTGRES_PASSWORD=

# 可选变量及当前安全默认值
# IMAGE_TAG=latest
# POSTGRES_DB=postgres
# POSTGRES_HOST=172.17.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# PUSH_BATCH_SIZE=10
# PUSH_CONFIG_REFRESH_INTERVAL=300
# PUSH_POLL_INTERVAL=10
# TZ=Asia/Shanghai
# WATCHTOWER_ENABLE=true
