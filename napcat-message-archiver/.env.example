# Docker Compose 环境变量示例

# 必填变量
POSTGRES_PASSWORD=

# 可选变量及当前安全默认值
# CONTAINER_NAME=napcat-message-archiver
# HOSTNAME=napcat-message-archiver
# IMAGE_TAG=latest
# POSTGRES_DB=postgres
# POSTGRES_HOST=postgres
# POSTGRES_PORT=5432
# TZ=Asia/Shanghai
# WATCHTOWER_ENABLE=true
# WS_URL=ws://172.17.0.1:3001
