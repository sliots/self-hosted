# Docker Compose 环境变量示例

# 必填变量
POSTGRES_PASSWORD=

# 可选变量及当前安全默认值
# BATCH_SIZE=50
# CLEANUP_INTERVAL=3600
# IMAGE_TAG=latest
# MIGRATION_BATCH_SIZE=10
# OVERWRITE_GROUP_IDS=
# OVERWRITE_USER_ID=
# POLL_INTERVAL=10
# POSTGRES_DB=postgres
# POSTGRES_HOST=172.17.0.1
# POSTGRES_PORT=5432
# POSTGRES_USER=postgres
# RETENTION_HOURS=12
# TZ=Asia/Shanghai
# WATCHTOWER_ENABLE=true
